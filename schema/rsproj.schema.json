{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Robotics Studio Project (RSPROJ)",
    "type": "object",
    "required": ["assembly", "meta", "script", "version"],
    "definitions": {
        "vec3": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 },
        "pinRef": {
            "type": "object",
            "required": ["uid", "pin"],
            "additionalProperties": false,
            "properties": {
                "uid": { "type": "integer", "description": "Component instance" },
                "pin": { "type": "string", "description": "Pin id in that component's .rsdef" }
            }
        }
    },
    "properties": {
        "schema": {
            "enum": [2, 3],
            "description": "Project format. Saved as 3; a file without it is schema 2 and loads as a Prototype project with no wiring."
        },
        "level": {
            "enum": ["prototype", "real"],
            "description": "prototype: one implicit ideal board runs script.current, every part auto-wired. real: board components run the sketch in their 'firmware' slot, through the wires below. Default prototype."
        },
        "wiring": {
            "type": "object",
            "description": "Real level: two-point wires between pins (grouped into nets at load) and the schematic layout. Kept, unused, at the Prototype level.",
            "properties": {
                "wires": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "required": ["a", "b"],
                        "additionalProperties": false,
                        "properties": {
                            "a": { "$ref": "#/definitions/pinRef" },
                            "b": { "$ref": "#/definitions/pinRef" }
                        }
                    }
                },
                "layout": {
                    "type": "object",
                    "description": "Schematic block positions: uid -> [x, y]",
                    "additionalProperties": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 }
                }
            }
        },
        "assembly": {
            "type": "object",
            "required": ["components"],
            "properties": {
                "components": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "required": ["uid", "model_id", "name", "connection"],
                        "properties": {
                            "uid": { "type": "integer" },
                            "model_id": { "type": "string" },
                            "name": { "type": "string" },
                            "firmware": { "type": "string", "description": "Boards only: the sketch (one of script.paths) this board runs at the Real level" },
                            "parameters": {
                                "type": "object",
                                "additionalProperties": { "type": "number" }
                            },
                            "connection": {
                                "anyOf": [
                                    { "type": "null" },
                                    {
                                        "type": "object",
                                        "required": ["parent_connector", "parent_uid", "self_connector", "snap_angle"],
                                        "properties": {
                                            "parent_connector": { "type": "string" },
                                            "parent_uid": { "type": "integer" },
                                            "self_connector": { "type": "string" },
                                            "snap_angle": { "type": "number" }
                                        }
                                    }
                                ]
                            }
                        }
                    }
                },
                "constraints": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "required": ["component_a", "component_b", "connector_a", "connector_b", "snap_angle"],
                        "properties": {
                            "component_a": { "type": "integer" },
                            "component_b": { "type": "integer" },
                            "connector_a": { "type": "string" },
                            "connector_b": { "type": "string" },
                            "snap_angle": { "type": "number" }
                        }
                    }
                },
                "transform": {
                    "type": "object",
                    "properties": {
                        "rotation": {
                            "type": "array",
                            "items": { "type": "number" },
                            "minItems": 3,
                            "maxItems": 3
                        }
                    }
                }
            }
        },
        "meta": {
            "type": "object",
            "required": ["name"],
            "properties": {
                "name": { "type": "string" },
                "author": { "type": "string" },
                "icon": { "type": "string" },
                "version": { "type": "string" }
            }
        },
        "script": {
            "type": "object",
            "description": "The project's firmware sketches; current = the one the ideal board runs at the Prototype level (-1 = none).",
            "required": ["current"],
            "properties": {
                "current": { "type": "integer" },
                "paths": {
                    "type": "array",
                    "items": { "type": "string" }
                }
            }
        },
        "serial_monitor": {
            "type": "object",
            "description": "Serial Monitor settings per board (key: the board's uid as a string; \"-1\" = the ideal board). UI state, like the plot layout.",
            "additionalProperties": {
                "type": "object",
                "properties": { "baud": { "type": "integer", "minimum": 1, "description": "the monitor's baud rate (a sketch at another rate shows garbage)" } }
            }
        },
        "plotting": {
            "type": "object",
            "description": "Plot panel layout: I/O canvases and body-motion targets.",
            "properties": {
                "canvases": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "required": ["name", "type"],
                        "properties": {
                            "name": { "type": "string" },
                            "type": { "enum": ["scalar", "vector", "image"] },
                            "enabled": { "type": "boolean", "description": "Whether the canvas records (holds subscriptions). Default true." },
                            "targets": {
                                "type": "array",
                                "items": {
                                    "type": "object",
                                    "required": ["uid", "signal"],
                                    "properties": {
                                        "uid": { "type": "integer", "description": "Component instance uid." },
                                        "signal": { "type": "string", "description": "Interface input/output name." },
                                        "color": { "type": "string", "description": "#rrggbb" }
                                    }
                                }
                            }
                        }
                    }
                },
                "motion": {
                    "type": "object",
                    "properties": {
                        "targets": {
                            "type": "array",
                            "items": {
                                "type": "object",
                                "required": ["uid", "body", "quantity"],
                                "properties": {
                                    "uid": { "type": "integer" },
                                    "body": { "type": "string" },
                                    "quantity": { "enum": ["linear_velocity", "angular_velocity", "linear_acceleration", "angular_acceleration"] },
                                    "local": { "type": "boolean", "description": "Local frame instead of world. Default false." },
                                    "color": { "type": "string", "description": "#rrggbb" }
                                }
                            }
                        }
                    }
                }
            }
        },
        "simulation": {
            "type": "object",
            "properties": {
                "seed": {
                    "type": "integer",
                    "description": "Seed of every random generator in a run (noise, drops, per-unit variation); the same seed repeats a run exactly. Default 1."
                }
            }
        },
        "stage": {
            "type": "object",
            "description": "The world around the robot, edited in the Stage panel. Missing fields take their defaults.",
            "properties": {
                "environment": {
                    "type": "object",
                    "properties": {
                        "skyTop": { "$ref": "#/definitions/vec3" },
                        "skyBottom": { "$ref": "#/definitions/vec3" },
                        "ambient": { "$ref": "#/definitions/vec3", "description": "Headlight ambient color." },
                        "headlight": { "$ref": "#/definitions/vec3", "description": "Headlight diffuse color." },
                        "light": {
                            "type": "object",
                            "properties": {
                                "dir": { "$ref": "#/definitions/vec3" },
                                "diffuse": { "$ref": "#/definitions/vec3" },
                                "castShadow": { "type": "boolean" }
                            }
                        },
                        "shadowSize": { "type": "integer" },
                        "fog": {
                            "type": "object",
                            "properties": {
                                "enabled": { "type": "boolean" },
                                "start": { "type": "number", "description": "Multiple of the model extent." },
                                "end": { "type": "number", "description": "Multiple of the model extent." },
                                "color": { "$ref": "#/definitions/vec3" }
                            }
                        },
                        "gravity": { "$ref": "#/definitions/vec3" },
                        "timestep": { "type": "number", "exclusiveMinimum": 0 }
                    }
                },
                "floor": {
                    "type": "object",
                    "properties": {
                        "type": { "enum": ["plane", "mesh", "heightfield", "none"] },
                        "pattern": { "enum": ["checker", "solid"] },
                        "color1": { "$ref": "#/definitions/vec3" },
                        "color2": { "$ref": "#/definitions/vec3" },
                        "texRepeat": { "type": "number" },
                        "file": { "type": "string", "description": "Mesh (.stl/.obj/.msh) or heightfield (.png), relative to the project." },
                        "scale": { "$ref": "#/definitions/vec3", "description": "Mesh scale; heightfield half x, half y, max height." },
                        "pos": { "$ref": "#/definitions/vec3" },
                        "euler": { "$ref": "#/definitions/vec3" },
                        "friction": { "$ref": "#/definitions/vec3" }
                    }
                },
                "props": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "required": ["id"],
                        "properties": {
                            "id": { "type": "string", "pattern": "^[A-Za-z0-9_]+$", "description": "Unique; the stage script sees prop_<id>." },
                            "shape": { "enum": ["box", "sphere", "cylinder", "capsule", "mesh"] },
                            "size": { "$ref": "#/definitions/vec3", "description": "MuJoCo geom size; mesh scale for meshes." },
                            "mesh": { "type": "string", "description": "Mesh file relative to the project (shape mesh)." },
                            "pos": { "$ref": "#/definitions/vec3" },
                            "euler": { "$ref": "#/definitions/vec3", "description": "Degrees." },
                            "rgba": { "type": "array", "items": { "type": "number" }, "minItems": 4, "maxItems": 4 },
                            "mass": { "type": "number", "exclusiveMinimum": 0 },
                            "friction": { "$ref": "#/definitions/vec3" },
                            "motion": { "enum": ["static", "dynamic", "controlled"] },
                            "control": {
                                "type": "object",
                                "properties": {
                                    "maxSpeed": { "type": "number", "description": "m/s" },
                                    "maxYawRate": { "type": "number", "description": "deg/s" },
                                    "response": { "type": "number", "description": "1/s; velocity gain = response * mass." }
                                }
                            }
                        }
                    }
                },
                "script": {
                    "type": "object",
                    "description": "Stage scripts (relative to the project) and the active one; current -1 = none.",
                    "required": ["current"],
                    "properties": {
                        "current": { "type": "integer" },
                        "paths": {
                            "type": "array",
                            "items": { "type": "string" }
                        }
                    }
                },
                "robotSpawn": { "$ref": "#/definitions/vec3", "description": "Offset of the robot's base body." }
            }
        },
        "version": {
            "type": "integer"
        }
    }
}

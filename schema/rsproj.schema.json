{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Robotics Studio Project (RSPROJ)",
    "type": "object",
    "required": ["assembly", "meta", "script", "version"],
    "properties": {
        "assembly": {
            "type": "object",
            "required": ["components"],
            "properties": {
                "components": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "required": ["uid", "model_id", "name", "connection"],
                        "properties": {
                            "uid": { "type": "integer" },
                            "model_id": { "type": "string" },
                            "name": { "type": "string" },
                            "parameters": {
                                "type": "object",
                                "additionalProperties": { "type": "number" }
                            },
                            "connection": {
                                "anyOf": [
                                    { "type": "null" },
                                    {
                                        "type": "object",
                                        "required": ["parent_connector", "parent_uid", "self_connector", "snap_angle"],
                                        "properties": {
                                            "parent_connector": { "type": "string" },
                                            "parent_uid": { "type": "integer" },
                                            "self_connector": { "type": "string" },
                                            "snap_angle": { "type": "number" }
                                        }
                                    }
                                ]
                            }
                        }
                    }
                },
                "constraints": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "required": ["component_a", "component_b", "connector_a", "connector_b", "snap_angle"],
                        "properties": {
                            "component_a": { "type": "integer" },
                            "component_b": { "type": "integer" },
                            "connector_a": { "type": "string" },
                            "connector_b": { "type": "string" },
                            "snap_angle": { "type": "number" }
                        }
                    }
                },
                "transform": {
                    "type": "object",
                    "properties": {
                        "rotation": {
                            "type": "array",
                            "items": { "type": "number" },
                            "minItems": 3,
                            "maxItems": 3
                        }
                    }
                }
            }
        },
        "meta": {
            "type": "object",
            "required": ["name"],
            "properties": {
                "name": { "type": "string" },
                "author": { "type": "string" },
                "icon": { "type": "string" },
                "version": { "type": "string" }
            }
        },
        "script": {
            "type": "object",
            "required": ["current"],
            "properties": {
                "current": { "type": "integer" },
                "paths": {
                    "type": "array",
                    "items": { "type": "string" }
                }
            }
        },
        "plotting": {
            "type": "object",
            "description": "Plot panel layout: I/O canvases and body-motion targets.",
            "properties": {
                "canvases": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "required": ["name", "type"],
                        "properties": {
                            "name": { "type": "string" },
                            "type": { "enum": ["scalar", "vector", "image"] },
                            "enabled": { "type": "boolean", "description": "Whether the canvas records (holds subscriptions). Default true." },
                            "targets": {
                                "type": "array",
                                "items": {
                                    "type": "object",
                                    "required": ["uid", "signal"],
                                    "properties": {
                                        "uid": { "type": "integer", "description": "Component instance uid." },
                                        "signal": { "type": "string", "description": "Interface input/output name." },
                                        "color": { "type": "string", "description": "#rrggbb" }
                                    }
                                }
                            }
                        }
                    }
                },
                "motion": {
                    "type": "object",
                    "properties": {
                        "targets": {
                            "type": "array",
                            "items": {
                                "type": "object",
                                "required": ["uid", "body", "quantity"],
                                "properties": {
                                    "uid": { "type": "integer" },
                                    "body": { "type": "string" },
                                    "quantity": { "enum": ["linear_velocity", "angular_velocity", "linear_acceleration", "angular_acceleration"] },
                                    "local": { "type": "boolean", "description": "Local frame instead of world. Default false." },
                                    "color": { "type": "string", "description": "#rrggbb" }
                                }
                            }
                        }
                    }
                }
            }
        },
        "simulation": {
            "type": "object"
        },
        "version": {
            "type": "integer"
        }
    }
}

{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Robotics Studio Component Definition (RSDEF), schema 3",
    "description": "Structure of an .rsdef file. JSON Schema cannot express cross-references, so these are checked elsewhere (ComponentData::fromJson and tools/validate_rsdef.py): ids unique within their kind (device ids across all device families; signal names across inputs and outputs), every target id resolves, joint and connector bodies exist, default_body is a body, tendon joints exist, joints sharing a body pair all have armature > 0.",
    "type": "object",
    "additionalProperties": false,
    "required": ["schema", "id", "meta", "kinematics", "connectors"],
    "properties": {
        "$schema": { "type": "string" },
        "schema": {
            "enum": [2, 3],
            "description": "Format version. Files are saved as 3; schema 2 (no board pins, no board block) still loads and is upgraded in memory."
        },
        "id": {
            "type": "string",
            "minLength": 1,
            "description": "Unique identifier for the component type (top level, not inside meta)"
        },
        "meta": {
            "type": "object",
            "required": ["name", "version"],
            "additionalProperties": false,
            "properties": {
                "name": { "type": "string" },
                "version": { "type": "string" },
                "author": { "type": "string" },
                "icon_path": { "type": "string" },
                "hint_class": {
                    "enum": ["actuator", "sensor", "vision", "display", "mcu", "weight", "battery", "part"],
                    "description": "Optional category; the robot tree shows an icon for it. Absent means generic. Keep in sync with src/Document/Components/HintClass.h"
                }
            }
        },
        "resources": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "meshes": {
                    "type": "object",
                    "additionalProperties": { "type": "string" }
                },
                "materials": {
                    "type": "object",
                    "additionalProperties": { "type": "string" }
                }
            }
        },
        "specs": {
            "type": "object",
            "description": "Free-form."
        },
        "pins": {
            "type": "array",
            "items": {
                "type": "object",
                "required": ["id"],
                "additionalProperties": false,
                "properties": {
                    "id": { "type": "string" },
                    "type": { "enum": ["pwm", "digital", "analog", "i2c_sda", "i2c_scl", "spi_sck", "spi_mosi", "spi_miso", "uart_tx", "uart_rx", "power", "ground", "gpio", "power_out"], "description": "Electrical role. Part pins: every type except power/ground is on the ideal board (it gets a pin number in robot_pins.h) and, at the Real level, is wired to a board gpio pin; power = a supply input (load). Board pins (only with a 'board' block): gpio = a pin the firmware drives, with 'number' and 'caps'; power_out = a supply output (5V, 3V3). Omit while untyped." },
                    "number": { "type": "integer", "minimum": 0, "description": "Board pins only: the number the sketch uses (Uno D9 = 9, A0 = 14). Required on gpio and internal pins; unique per board." },
                    "caps": { "type": "array", "items": { "enum": ["digital", "pwm", "analog", "interrupt", "i2c_sda", "i2c_scl", "spi_sck", "spi_mosi", "spi_miso", "uart_tx", "uart_rx"] }, "description": "gpio pins only: what the pin can do." },
                    "internal": { "type": "boolean", "description": "Board pins only: hard-wired on the board's PCB (the ESP32-CAM's camera pins). Not wireable; the sketch still sees its number." },
                    "voltage_range": { "$ref": "#/definitions/pair" },
                    "description": { "type": "string" }
                }
            }
        },
        "board": {
            "type": "object",
            "required": ["fqbn", "header_folder", "logic_voltage"],
            "additionalProperties": false,
            "description": "Makes the component a board: it runs a firmware sketch at the Real level. Pin references name gpio pins with the matching capability.",
            "properties": {
                "fqbn": { "type": "string", "description": "arduino-cli board, e.g. arduino:avr:uno" },
                "header_folder": { "type": "string", "description": "Project subfolder that receives the board's generated robot_pins.h (uno, esp32cam)" },
                "logic_voltage": { "type": "number", "description": "Volts on a HIGH output" },
                "adc": {
                    "type": "object", "additionalProperties": false,
                    "properties": { "bits": { "type": "integer" }, "vref": { "type": "number" } }
                },
                "analog_write": {
                    "type": "object", "additionalProperties": false,
                    "properties": {
                        "hz": { "type": "number", "description": "analogWrite() PWM frequency" },
                        "pins": { "type": "object", "additionalProperties": { "type": "number" }, "description": "pin id -> frequency, where it differs" }
                    }
                },
                "i2c": {
                    "type": "object", "additionalProperties": false,
                    "properties": { "sda": { "type": "string" }, "scl": { "type": "string" }, "default_hz": { "type": "number" } }
                },
                "spi": {
                    "type": "object", "additionalProperties": false,
                    "properties": { "sck": { "type": "string" }, "mosi": { "type": "string" }, "miso": { "type": "string" }, "max_hz": { "type": "number" } }
                },
                "sources": { "type": "object", "additionalProperties": { "type": "string" }, "description": "field -> where its value comes from (datasheet, estimate)" }
            }
        },
        "power": {
            "type": "object",
            "additionalProperties": false,
            "description": "The part's electrical side at the Real level: what it supplies, converts and draws. Pin references: supplies and regulator outputs on power_out pins, loads on power pins, regulator inputs on either. Not used at the Prototype level (ideal power).",
            "properties": {
                "supplies": {
                    "type": "array",
                    "items": {
                        "type": "object", "required": ["pin", "kind"], "additionalProperties": false,
                        "properties": {
                            "pin": { "type": "string" },
                            "kind": { "enum": ["usb", "battery", "supply"], "description": "usb: a board's default feed, dropped when another source drives its net; battery: voltage and resistance from the 'battery' curve; supply: a bench supply (per-instance voltage and current limit)" },
                            "voltage": { "type": "number", "description": "Open-circuit volts (not for batteries)" },
                            "r_internal_ohm": { "type": "number", "minimum": 0 },
                            "current_limit_a": { "type": "number", "minimum": 0, "description": "supply: constant-current limit" },
                            "hold_current_a": { "type": "number", "minimum": 0, "description": "usb: the polyfuse's hold current (warnings)" }
                        }
                    }
                },
                "regulators": {
                    "type": "array",
                    "items": {
                        "type": "object", "required": ["id", "in", "out", "v_out", "i_max_a"], "additionalProperties": false,
                        "properties": {
                            "id": { "type": "string" },
                            "in": { "type": "string", "description": "a power pin, or a power_out rail feeding the next regulator" },
                            "out": { "type": "string", "description": "a power_out pin" },
                            "kind": { "enum": ["linear", "buck"] },
                            "v_out": { "type": "number" },
                            "dropout_v": { "type": "number", "minimum": 0, "description": "linear: volts below the input at full load; buck: minimum headroom" },
                            "efficiency": { "type": "number", "exclusiveMinimum": 0, "maximum": 1, "description": "buck" },
                            "i_max_a": { "type": "number", "exclusiveMinimum": 0, "description": "rated output current (the budget check)" },
                            "i_limit_a": { "type": "number", "exclusiveMinimum": 0, "description": "current limit: above it the output folds back (default i_max_a)" },
                            "i_quiescent_ma": { "type": "number", "minimum": 0 }
                        }
                    }
                },
                "loads": {
                    "type": "array",
                    "items": {
                        "type": "object", "required": ["pin"], "additionalProperties": false,
                        "properties": {
                            "pin": { "type": "string" },
                            "current_ma": { "type": "number", "minimum": 0, "description": "typical static draw; motors add their own current" },
                            "min_v": { "type": "number", "minimum": 0, "description": "the part works at or above this supply voltage; below it is off" }
                        }
                    }
                },
                "brownout": {
                    "type": "object", "required": ["rail", "threshold_v"], "additionalProperties": false,
                    "description": "Boards: the MCU resets when this rail drops below the threshold",
                    "properties": {
                        "rail": { "type": "string" },
                        "threshold_v": { "type": "number" },
                        "hysteresis_v": { "type": "number", "minimum": 0 },
                        "restart_ms": { "type": "number", "minimum": 0, "description": "from release to setup()" }
                    }
                },
                "battery": {
                    "type": "object", "required": ["capacity_mah", "curve"], "additionalProperties": false,
                    "properties": {
                        "cells": { "type": "integer", "minimum": 1, "description": "cells in series; the curve and the thresholds are per cell (default 1)" },
                        "capacity_mah": { "type": "number", "exclusiveMinimum": 0, "description": "rated capacity: at the datasheet's drain down to its cut-off voltage (= 0 %)" },
                        "curve": {
                            "type": "array", "minItems": 2,
                            "items": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "number" } },
                            "description": "[charge %, open-circuit V, internal ohm] per cell, interpolated; up to 100 %, with a point at 0 % (the rated cut-off); points below 0 % are the charge a cell still gives past it, down to its dead point"
                        },
                        "rate": {
                            "type": "object", "required": ["available_fraction", "rate_constant_per_h"], "additionalProperties": false,
                            "description": "Rate-capacity and recovery (Kinetic Battery Model): the load draws from an available well; the bound charge flows into it at rate_constant_per_h x (bound level - available level)",
                            "properties": {
                                "available_fraction": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
                                "rate_constant_per_h": { "type": "number", "exclusiveMinimum": 0 }
                            }
                        },
                        "over_discharge_v": { "type": "number", "minimum": 0, "description": "per cell, open circuit: below it a real cell is damaged (a warning)" },
                        "protection": {
                            "type": "object", "required": ["cutoff_v"], "additionalProperties": false,
                            "description": "A protection circuit (BMS): below cutoff_v per cell at the terminals for delay_ms it cuts the pack off until Stop",
                            "properties": {
                                "cutoff_v": { "type": "number", "exclusiveMinimum": 0 },
                                "delay_ms": { "type": "number", "minimum": 0 },
                                "fitted": { "type": "boolean", "description": "default for an instance (Inspector 'Protection circuit (BMS)'); default false" }
                            }
                        }
                    }
                },
                "sources": { "type": "object", "additionalProperties": { "type": "string" }, "description": "supplies.<pin>, regulators.<id>, loads.<pin>, brownout, battery, battery.rate, battery.protection -> where the numbers come from (datasheet, measurement, estimate)" }
            }
        },
        "kinematics": {
            "type": "object",
            "required": ["default_body", "bodies"],
            "additionalProperties": false,
            "properties": {
                "default_body": { "type": "string" },
                "bodies": {
                    "type": "array",
                    "items": { "$ref": "#/definitions/body" }
                },
                "joints": {
                    "type": "array",
                    "items": { "$ref": "#/definitions/joint" }
                },
                "tendons": {
                    "type": "array",
                    "items": { "$ref": "#/definitions/tendon" }
                }
            }
        },
        "connectors": {
            "type": "array",
            "items": {
                "type": "object",
                "required": ["id", "body"],
                "additionalProperties": false,
                "properties": {
                    "id": { "type": "string" },
                    "body": { "type": "string" },
                    "description": { "type": "string" },
                    "mechanics": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                            "snap_angles": {
                                "type": "array",
                                "items": { "type": "number" }
                            }
                        }
                    },
                    "transform": { "$ref": "#/definitions/transform" }
                }
            }
        },
        "devices": {
            "type": "object",
            "description": "Things attached to the structure. Omit empty families. Unknown families are rejected (typo detection). Cameras render from their site (looking along its -Z, +Y up); displays take pixels from the script.",
            "additionalProperties": false,
            "properties": {
                "actuators": { "type": "array", "items": { "$ref": "#/definitions/actuator" } },
                "sensors": { "type": "array", "items": { "$ref": "#/definitions/sensor" } },
                "cameras": { "type": "array", "items": { "$ref": "#/definitions/camera" } },
                "displays": { "type": "array", "items": { "$ref": "#/definitions/display" } }
            }
        },
        "interface": {
            "type": "object",
            "description": "The component's public signals.",
            "additionalProperties": false,
            "properties": {
                "inputs": { "type": "array", "items": { "$ref": "#/definitions/inputSignal" } },
                "outputs": { "type": "array", "items": { "$ref": "#/definitions/outputSignal" } }
            }
        },
        "emulator": {
            "type": "object",
            "description": "Hardware-error model: the C++ class (EmulatorFactory) that turns script calls into device values and back.",
            "additionalProperties": false,
            "properties": {
                "type": {
                    "type": "string",
                    "description": "EmulatorFactory type. Empty or absent: default_emulator. Unknown types are logged and the component gets no emulator.",
                    "examples": ["servo_emulator", "stepper_emulator", "dc_gear_emulator", "imu_emulator", "camera_emulator", "display_emulator", "default_emulator"]
                },
                "source": { "type": ["object", "null"], "description": "Reserved for a custom emulator script; unused." },
                "parameters": { "type": "object", "description": "Free-form, read by the emulator in init(). Known keys of some types are typed below; others pass through." },
                "parameter_sources": {
                    "type": "object",
                    "description": "Where each parameter's value comes from: a datasheet (with a link), a measurement (what, how, when), or 'estimate: ...'. validate_rsdef.py warns about parameters without one.",
                    "additionalProperties": { "type": "string" }
                }
            },
            "allOf": [
                {
                    "if": { "properties": { "type": { "const": "camera_emulator" } }, "required": ["type"] },
                    "then": { "properties": { "parameters": { "$ref": "#/definitions/cameraEmulatorParameters" } } }
                },
                {
                    "if": { "properties": { "type": { "const": "display_emulator" } }, "required": ["type"] },
                    "then": { "properties": { "parameters": { "$ref": "#/definitions/displayEmulatorParameters" } } }
                },
                {
                    "if": { "properties": { "type": { "const": "servo_emulator" } }, "required": ["type"] },
                    "then": { "properties": { "parameters": { "$ref": "#/definitions/servoEmulatorParameters" } } }
                }
            ]
        }
    },
    "definitions": {
        "pair": {
            "type": "array",
            "items": { "type": "number" },
            "minItems": 2,
            "maxItems": 2
        },
        "resolution": {
            "type": "array",
            "items": { "type": "integer", "minimum": 1 },
            "minItems": 2,
            "maxItems": 2
        },
        "transform": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "pos": {
                    "type": "array",
                    "items": { "type": "number" },
                    "minItems": 3,
                    "maxItems": 3
                },
                "quat": {
                    "type": "array",
                    "items": { "type": "number" },
                    "minItems": 4,
                    "maxItems": 4
                }
            }
        },
        "body": {
            "type": "object",
            "description": "overrideGeom true: the body's mass/inertia are authoritative and geoms carry no mass. Otherwise every geom carries its own mass and the body has none.",
            "required": ["id"],
            "additionalProperties": false,
            "properties": {
                "id": { "type": "string" },
                "overrideGeom": { "type": "boolean" },
                "mass": { "type": "number" },
                "inertia": { "type": "number", "description": "One scalar, used for all three principal axes." },
                "transform": { "$ref": "#/definitions/transform" },
                "geoms": { "type": "array", "items": { "$ref": "#/definitions/geom" } },
                "sites": { "type": "array", "items": { "$ref": "#/definitions/site" } }
            },
            "if": {
                "properties": { "overrideGeom": { "const": true } },
                "required": ["overrideGeom"]
            },
            "then": {
                "required": ["mass", "inertia"],
                "properties": {
                    "geoms": { "items": { "properties": { "mass": false } } }
                }
            },
            "else": {
                "properties": {
                    "mass": false,
                    "inertia": false,
                    "geoms": { "items": { "required": ["mass"] } }
                }
            }
        },
        "geom": {
            "type": "object",
            "description": "Extra keys are tolerated (and ignored by the loader), e.g. the wheel's unused 'friction'.",
            "required": ["id", "type"],
            "properties": {
                "id": { "type": "string", "minLength": 1 },
                "type": { "enum": ["mesh", "box", "sphere", "capsule", "cylinder"] },
                "mesh": { "type": "string" },
                "material": { "type": "string" },
                "color": {
                    "type": "array",
                    "items": { "type": "number" },
                    "minItems": 3,
                    "maxItems": 4,
                    "description": "Only used when the geom has no material."
                },
                "size": { "type": "array", "items": { "type": "number" } },
                "pos": {
                    "type": "array",
                    "items": { "type": "number" },
                    "minItems": 3,
                    "maxItems": 3
                },
                "quat": {
                    "type": "array",
                    "items": { "type": "number" },
                    "minItems": 4,
                    "maxItems": 4
                },
                "mass": { "type": "number" }
            }
        },
        "site": {
            "type": "object",
            "description": "A named frame. Sensors and cameras attach to it through devices.",
            "required": ["id"],
            "additionalProperties": false,
            "properties": {
                "id": { "type": "string", "minLength": 1 },
                "transform": { "$ref": "#/definitions/transform" }
            }
        },
        "joint": {
            "type": "object",
            "description": "Passive properties only. Actuators and sensors are devices that target the joint. A joint's value is the rotation of body_b relative to body_a about the joint axis.",
            "required": ["id", "body_a", "body_b", "type"],
            "additionalProperties": false,
            "properties": {
                "id": { "type": "string", "minLength": 1 },
                "body_a": { "type": "string" },
                "body_b": { "type": "string" },
                "type": { "enum": ["hinge", "slide", "ball", "free"] },
                "transform": { "$ref": "#/definitions/transform" },
                "range": { "$ref": "#/definitions/pair" },
                "damping": { "type": "number" },
                "armature": { "type": "number" },
                "frictionloss": { "type": "number" },
                "collision": { "type": "boolean" },
                "sources": {
                    "type": "object",
                    "description": "Where a field's value comes from (datasheet, measurement, or 'estimate: ...'). Expected for the range of a play-gap (backlash) joint.",
                    "propertyNames": { "enum": ["range", "damping", "armature", "frictionloss"] },
                    "additionalProperties": { "type": "string" }
                }
            }
        },
        "tendon": {
            "type": "object",
            "description": "Fixed tendon: length = sum(coef * joint value). Coefficients are in each joint's logical direction (body_a -> body_b) and are used as written.",
            "required": ["id", "type", "terms"],
            "additionalProperties": false,
            "properties": {
                "id": { "type": "string", "minLength": 1 },
                "type": { "const": "fixed" },
                "terms": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "type": "object",
                        "required": ["joint", "coef"],
                        "additionalProperties": false,
                        "properties": {
                            "joint": { "type": "string" },
                            "coef": { "type": "number" }
                        }
                    }
                }
            }
        },
        "targetOf": {
            "type": "object",
            "description": "target {kind, id}; see the per-family definitions for the allowed kinds.",
            "required": ["kind", "id"],
            "additionalProperties": false,
            "properties": {
                "kind": { "type": "string" },
                "id": { "type": "string", "minLength": 1 }
            }
        },
        "actuator": {
            "type": "object",
            "required": ["id", "type", "target"],
            "additionalProperties": false,
            "properties": {
                "id": { "type": "string", "minLength": 1 },
                "type": { "enum": ["position", "velocity", "motor"] },
                "target": {
                    "allOf": [
                        { "$ref": "#/definitions/targetOf" },
                        { "properties": { "kind": { "enum": ["joint", "tendon"] } } }
                    ]
                },
                "ctrlrange": { "$ref": "#/definitions/pair", "description": "Command limits in the unit of the input signal that drives this actuator (degrees for a degrees signal); converted to MuJoCo units on load." },
                "forcerange": { "$ref": "#/definitions/pair" },
                "kp": { "type": "number" },
                "kv": { "type": "number" }
            }
        },
        "sensor": {
            "type": "object",
            "description": "Observes a native MuJoCo quantity. Other MuJoCo sensor types are reserved and rejected.",
            "required": ["id", "type", "target"],
            "additionalProperties": false,
            "properties": {
                "id": { "type": "string", "minLength": 1 },
                "type": { "enum": ["jointpos", "jointvel", "tendonpos", "tendonvel", "accelerometer", "gyro"] },
                "target": { "$ref": "#/definitions/targetOf" }
            },
            "allOf": [
                {
                    "if": { "properties": { "type": { "enum": ["jointpos", "jointvel"] } } },
                    "then": { "properties": { "target": { "properties": { "kind": { "const": "joint" } } } } }
                },
                {
                    "if": { "properties": { "type": { "enum": ["tendonpos", "tendonvel"] } } },
                    "then": { "properties": { "target": { "properties": { "kind": { "const": "tendon" } } } } }
                },
                {
                    "if": { "properties": { "type": { "enum": ["accelerometer", "gyro"] } } },
                    "then": { "properties": { "target": { "properties": { "kind": { "const": "site" } } } } }
                }
            ]
        },
        "camera": {
            "type": "object",
            "description": "A MuJoCo camera placed exactly on its target site: it looks along the site's -Z axis with +Y up. Frames reach scripts through camera_emulator.",
            "required": ["id", "type", "target", "resolution", "fovy"],
            "additionalProperties": false,
            "properties": {
                "id": { "type": "string", "minLength": 1 },
                "type": {
                    "enum": ["rgb", "depth"],
                    "description": "rgb: 3 bytes per pixel. depth: float meters along the view axis, 0 = no return."
                },
                "target": {
                    "allOf": [
                        { "$ref": "#/definitions/targetOf" },
                        { "properties": { "kind": { "const": "site" } } }
                    ]
                },
                "resolution": { "$ref": "#/definitions/resolution", "description": "[width, height] in pixels. The generated model sizes MuJoCo's offscreen buffer for the largest camera." },
                "fovy": { "type": "number", "exclusiveMinimum": 0, "description": "Vertical field of view, degrees." }
            }
        },
        "cameraEmulatorParameters": {
            "type": "object",
            "description": "camera_emulator parameters. All optional.",
            "properties": {
                "fps": { "type": "number", "exclusiveMinimum": 0, "description": "Frames per sim second (default 15)." },
                "latency_ms": { "type": "number", "minimum": 0, "description": "Capture to visible-to-script delay, sim ms (default 50)." },
                "drop_probability": { "type": "number", "minimum": 0, "maximum": 1, "description": "Chance a frame is lost (default 0)." },
                "noise_stddev": { "type": "number", "minimum": 0, "description": "rgb: per-channel Gaussian noise, 0..255 scale (default 0)." },
                "color_gain": {
                    "type": "array",
                    "items": { "type": "number", "minimum": 0 },
                    "minItems": 3,
                    "maxItems": 3,
                    "description": "rgb: [r, g, b] channel gains (default [1, 1, 1])."
                },
                "bits_per_channel": { "type": "integer", "minimum": 1, "maximum": 8, "description": "rgb: quantisation (default 8)." },
                "depth_noise_stddev": { "type": "number", "minimum": 0, "description": "depth: Gaussian noise, meters (default 0)." },
                "depth_min": { "type": "number", "minimum": 0, "description": "depth: closer reads 0; 0 = no limit (default 0)." },
                "depth_max": { "type": "number", "minimum": 0, "description": "depth: farther reads 0; 0 = no limit (default 0)." }
            }
        },
        "displayEmulatorParameters": {
            "type": "object",
            "description": "display_emulator parameters. All optional.",
            "properties": {
                "refresh_hz": { "type": "number", "exclusiveMinimum": 0, "description": "Panel refresh rate, sim time (default 30)." }
            }
        },
        "servoEmulatorParameters": {
            "type": "object",
            "description": "servo_emulator parameters (analog hobby servo). All optional.",
            "properties": {
                "pulse_min_us": { "type": "number", "exclusiveMinimum": 0, "description": "Pulse width at -travel_deg/2 (default 1000)." },
                "pulse_max_us": { "type": "number", "exclusiveMinimum": 0, "description": "Pulse width at +travel_deg/2 (default 2000)." },
                "travel_deg": { "type": "number", "exclusiveMinimum": 0, "description": "Angle between pulse_min_us and pulse_max_us (default 180)." },
                "frame_period_ms": { "type": "number", "exclusiveMinimum": 0, "description": "Pulse frame; the servo acts on one pulse per frame (default 20)." },
                "deadband_us": { "type": "number", "minimum": 0, "description": "Full dead band width of the servo's controller, in pulse microseconds (default 0)." },
                "proportional_band_deg": { "type": "number", "exclusiveMinimum": 0, "description": "Position error that gives full motor drive (default 5)." },
                "stall_torque_nm": { "type": "number", "minimum": 0, "description": "Stall torque at rated_voltage, N·m." },
                "no_load_speed_dps": { "type": "number", "minimum": 0, "description": "No-load output speed at rated_voltage, degrees per second." },
                "rated_voltage": { "type": "number", "exclusiveMinimum": 0, "description": "Voltage the torque and speed figures are given at (default 5)." },
                "supply_voltage": { "type": "number", "minimum": 0, "description": "Voltage the servo runs at (default 5)." },
                "pot_noise_deg": { "type": "number", "minimum": 0, "description": "Noise of the position pot reading, stddev in degrees (default 0)." },
                "center_spread_us": { "type": "number", "minimum": 0, "description": "Unit-to-unit spread of the centre pulse, stddev in microseconds (default 0)." },
                "gain_spread": { "type": "number", "minimum": 0, "description": "Unit-to-unit spread of the pulse-to-angle scale, stddev as a fraction (default 0)." }
            }
        },
        "display": {
            "type": "object",
            "description": "A pixel buffer shown on a geom. Displays take no 'type'.",
            "required": ["id", "target", "resolution", "surface"],
            "additionalProperties": false,
            "properties": {
                "id": { "type": "string", "minLength": 1 },
                "target": {
                    "allOf": [
                        { "$ref": "#/definitions/targetOf" },
                        { "properties": { "kind": { "const": "geom" } } }
                    ]
                },
                "resolution": { "$ref": "#/definitions/resolution" },
                "surface": {
                    "type": "object",
                    "description": "Where the screen is drawn, in the target geom's parent body frame. Faces +Z; image right = +X, image up = +Y. size: half-extents in meters.",
                    "required": ["transform", "size"],
                    "additionalProperties": false,
                    "properties": {
                        "transform": { "$ref": "#/definitions/transform" },
                        "size": {
                            "type": "array",
                            "items": { "type": "number", "exclusiveMinimum": 0 },
                            "minItems": 2,
                            "maxItems": 2
                        }
                    }
                }
            }
        },
        "domain": {
            "description": "Advisory value domain in the signal's own unit. Omitted means unbounded.",
            "oneOf": [
                {
                    "type": "object",
                    "required": ["type", "parameters"],
                    "additionalProperties": false,
                    "properties": {
                        "type": { "const": "ranged" },
                        "parameters": {
                            "type": "object",
                            "required": ["min", "max"],
                            "additionalProperties": false,
                            "properties": {
                                "min": { "type": "number" },
                                "max": { "type": "number" }
                            }
                        }
                    }
                },
                {
                    "type": "object",
                    "required": ["type"],
                    "additionalProperties": false,
                    "properties": {
                        "type": { "const": "unbounded" },
                        "parameters": {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {}
                        }
                    }
                }
            ]
        },
        "signalCommon": {
            "type": "object",
            "description": "shape and dim are derived from the target device type; only emulator-kind signals state channel_type and dim.",
            "required": ["name", "physical", "target"],
            "properties": {
                "name": { "type": "string", "minLength": 1, "description": "Unique across inputs and outputs." },
                "unit": { "type": "string", "description": "degrees/deg/degree and degrees/s/deg/s/degree/s/dps are converted to radians (per second) for MuJoCo; any other unit is a label." },
                "domain": { "$ref": "#/definitions/domain" },
                "physical": { "type": "boolean", "description": "true if a real device would expose it (a pin), false for simulation-only ground truth." },
                "internal": { "type": "boolean", "description": "The part's own internal state (motor drive, pot reading, gear speed). Listed apart from the part's inputs and outputs in the plot picker and Inspector. Default false." },
                "componentLabels": { "type": "array", "items": { "type": "string" } },
                "channel_type": { "enum": ["scalar", "vector"] },
                "dim": { "type": "integer", "minimum": 1 }
            },
            "if": {
                "properties": { "target": { "properties": { "kind": { "const": "emulator" } }, "required": ["kind"] } },
                "required": ["target"]
            },
            "then": {
                "required": ["channel_type", "dim"],
                "if": { "properties": { "channel_type": { "const": "scalar" } } },
                "then": { "properties": { "dim": { "const": 1 } } }
            },
            "else": {
                "properties": { "channel_type": false, "dim": false }
            }
        },
        "emulatorTarget": {
            "type": "object",
            "description": "A signal with no engine-side footprint; the emulator owns it. Takes no id.",
            "required": ["kind"],
            "additionalProperties": false,
            "properties": { "kind": { "const": "emulator" } }
        },
        "inputSignal": {
            "description": "joint: pose in edit mode and emulator command in play mode; display: pixel input; actuator: reserved fallback for commands with no joint (play-mode ctrl only); emulator: emulator-owned signal.",
            "allOf": [
                { "$ref": "#/definitions/signalCommon" },
                {
                    "additionalProperties": false,
                    "properties": {
                        "name": {}, "unit": {}, "domain": {}, "physical": {}, "internal": {}, "componentLabels": {}, "channel_type": {}, "dim": {},
                        "target": {
                            "oneOf": [
                                {
                                    "allOf": [
                                        { "$ref": "#/definitions/targetOf" },
                                        { "properties": { "kind": { "enum": ["joint", "display", "actuator"] } } }
                                    ]
                                },
                                { "$ref": "#/definitions/emulatorTarget" }
                            ]
                        }
                    }
                }
            ]
        },
        "outputSignal": {
            "description": "sensor: value read from that sensor; camera: image; emulator: emulator-owned signal.",
            "allOf": [
                { "$ref": "#/definitions/signalCommon" },
                {
                    "additionalProperties": false,
                    "properties": {
                        "name": {}, "unit": {}, "domain": {}, "physical": {}, "internal": {}, "componentLabels": {}, "channel_type": {}, "dim": {},
                        "target": {
                            "oneOf": [
                                {
                                    "allOf": [
                                        { "$ref": "#/definitions/targetOf" },
                                        { "properties": { "kind": { "enum": ["sensor", "camera"] } } }
                                    ]
                                },
                                { "$ref": "#/definitions/emulatorTarget" }
                            ]
                        }
                    }
                }
            ]
        }
    }
}

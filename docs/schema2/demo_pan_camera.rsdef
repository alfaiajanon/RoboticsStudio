{
    "schema": 2,
    "id": "demo_pan_camera",
    "meta": {
        "name": "Pan Camera Module (schema demo)",
        "version": "1.0.0",
        "author": "Anon",
        "icon_path": "demo.png"
    },
    "resources": {
        "meshes": {},
        "materials": {}
    },
    "specs": {
        "voltage_min": 4.8,
        "voltage_max": 6.0,
        "max_torque_nm": 0.176,
        "backlash_play_deg": 10,
        "weight_kg": 0.09
    },
    "pins": [
        {
            "id": "vcc",
            "voltage_range": [
                4.8,
                6.0
            ],
            "description": "Power input"
        },
        {
            "id": "gnd",
            "description": "Ground"
        },
        {
            "id": "signal",
            "description": "PWM signal for the pan servo"
        },
        {
            "id": "sda",
            "description": "I2C data (IMU, display)"
        },
        {
            "id": "scl",
            "description": "I2C clock (IMU, display)"
        }
    ],
    "kinematics": {
        "default_body": "base",
        "bodies": [
            {
                "id": "base",
                "overrideGeom": false,
                "transform": {
                    "pos": [
                        0,
                        0,
                        0
                    ],
                    "quat": [
                        1,
                        0,
                        0,
                        0
                    ]
                },
                "geoms": [
                    {
                        "id": "base_plate",
                        "type": "box",
                        "size": [
                            0.03,
                            0.03,
                            0.01
                        ],
                        "pos": [
                            0,
                            0,
                            0.01
                        ],
                        "quat": [
                            1,
                            0,
                            0,
                            0
                        ],
                        "color": [
                            0.25,
                            0.25,
                            0.3,
                            1.0
                        ],
                        "mass": 0.05
                    }
                ]
            },
            {
                "id": "gear_dummy",
                "overrideGeom": true,
                "mass": 0.002,
                "inertia": 1e-07,
                "transform": {
                    "pos": [
                        0,
                        0,
                        0.02
                    ],
                    "quat": [
                        1,
                        0,
                        0,
                        0
                    ]
                },
                "geoms": []
            },
            {
                "id": "head",
                "overrideGeom": false,
                "transform": {
                    "pos": [
                        0,
                        0,
                        0.02
                    ],
                    "quat": [
                        1,
                        0,
                        0,
                        0
                    ]
                },
                "geoms": [
                    {
                        "id": "head_body",
                        "type": "box",
                        "size": [
                            0.02,
                            0.03,
                            0.015
                        ],
                        "pos": [
                            0,
                            0,
                            0.015
                        ],
                        "quat": [
                            1,
                            0,
                            0,
                            0
                        ],
                        "color": [
                            0.8,
                            0.8,
                            0.85,
                            1.0
                        ],
                        "mass": 0.03
                    },
                    {
                        "id": "screen_panel",
                        "type": "box",
                        "size": [
                            0.015,
                            0.001,
                            0.008
                        ],
                        "pos": [
                            0,
                            0.031,
                            0.012
                        ],
                        "quat": [
                            1,
                            0,
                            0,
                            0
                        ],
                        "color": [
                            0.05,
                            0.05,
                            0.08,
                            1.0
                        ],
                        "mass": 0.001
                    }
                ],
                "sites": [
                    {
                        "id": "lens",
                        "transform": {
                            "pos": [
                                0,
                                0.0305,
                                0.025
                            ],
                            "quat": [
                                0.7071068,
                                0.7071068,
                                0,
                                0
                            ]
                        }
                    },
                    {
                        "id": "imu",
                        "transform": {
                            "pos": [
                                0,
                                0,
                                0.015
                            ],
                            "quat": [
                                1,
                                0,
                                0,
                                0
                            ]
                        }
                    }
                ]
            }
        ],
        "joints": [
            {
                "id": "pan_joint",
                "type": "hinge",
                "body_a": "base",
                "body_b": "gear_dummy",
                "transform": {
                    "pos": [
                        0,
                        0,
                        0.02
                    ],
                    "quat": [
                        1,
                        0,
                        0,
                        0
                    ]
                },
                "range": [
                    -90,
                    90
                ],
                "damping": 0.01,
                "armature": 0.005,
                "frictionloss": 0.01,
                "collision": true
            },
            {
                "id": "gap_joint",
                "type": "hinge",
                "body_a": "gear_dummy",
                "body_b": "head",
                "transform": {
                    "pos": [
                        0,
                        0,
                        0.02
                    ],
                    "quat": [
                        1,
                        0,
                        0,
                        0
                    ]
                },
                "range": [
                    -5,
                    5
                ],
                "damping": 0.02,
                "armature": 0.0005,
                "frictionloss": 0.0005,
                "collision": false
            }
        ],
        "tendons": [
            {
                "id": "horn_angle",
                "type": "fixed",
                "terms": [
                    {
                        "joint": "pan_joint",
                        "coef": 1
                    },
                    {
                        "joint": "gap_joint",
                        "coef": 1
                    }
                ]
            }
        ]
    },
    "connectors": [
        {
            "id": "base_mount",
            "body": "base",
            "description": "Flat bottom surface",
            "mechanics": {
                "snap_angles": [
                    0,
                    90,
                    180,
                    270
                ]
            },
            "transform": {
                "pos": [
                    0,
                    0,
                    0
                ],
                "quat": [
                    0,
                    1,
                    0,
                    0
                ]
            }
        },
        {
            "id": "head_top",
            "body": "head",
            "description": "Top of the camera head",
            "transform": {
                "pos": [
                    0,
                    0,
                    0.05
                ],
                "quat": [
                    1,
                    0,
                    0,
                    0
                ]
            }
        }
    ],
    "devices": {
        "actuators": [
            {
                "id": "pan_motor",
                "type": "position",
                "target": {
                    "kind": "joint",
                    "id": "pan_joint"
                },
                "ctrlrange": [
                    -90,
                    90
                ],
                "forcerange": [
                    -0.176,
                    0.176
                ],
                "kp": 5,
                "kv": 0.5
            }
        ],
        "sensors": [
            {
                "id": "gap_pos",
                "type": "jointpos",
                "target": {
                    "kind": "joint",
                    "id": "gap_joint"
                }
            },
            {
                "id": "head_angle",
                "type": "tendonpos",
                "target": {
                    "kind": "tendon",
                    "id": "horn_angle"
                }
            },
            {
                "id": "imu_accel",
                "type": "accelerometer",
                "target": {
                    "kind": "site",
                    "id": "imu"
                }
            },
            {
                "id": "imu_gyro",
                "type": "gyro",
                "target": {
                    "kind": "site",
                    "id": "imu"
                }
            }
        ],
        "cameras": [
            {
                "id": "cam",
                "type": "rgb",
                "target": {
                    "kind": "site",
                    "id": "lens"
                },
                "resolution": [
                    320,
                    240
                ],
                "fovy": 60
            }
        ],
        "displays": [
            {
                "id": "screen",
                "target": {
                    "kind": "geom",
                    "id": "screen_panel"
                },
                "resolution": [
                    128,
                    64
                ]
            }
        ]
    },
    "interface": {
        "inputs": [
            {
                "name": "target_angle",
                "unit": "degrees",
                "domain": {
                    "type": "ranged",
                    "parameters": {
                        "min": -90,
                        "max": 90
                    }
                },
                "physical": true,
                "target": {
                    "kind": "joint",
                    "id": "pan_joint"
                }
            },
            {
                "name": "framebuffer",
                "physical": true,
                "target": {
                    "kind": "display",
                    "id": "screen"
                }
            },
            {
                "name": "backlight",
                "domain": {
                    "type": "ranged",
                    "parameters": {
                        "min": 0,
                        "max": 1
                    }
                },
                "physical": true,
                "target": {
                    "kind": "emulator"
                },
                "channel_type": "scalar",
                "dim": 1
            }
        ],
        "outputs": [
            {
                "name": "current_angle",
                "unit": "degrees",
                "physical": false,
                "target": {
                    "kind": "sensor",
                    "id": "head_angle"
                }
            },
            {
                "name": "gap_angle",
                "unit": "degrees",
                "physical": false,
                "target": {
                    "kind": "sensor",
                    "id": "gap_pos"
                }
            },
            {
                "name": "acceleration",
                "unit": "m/s^2",
                "physical": true,
                "target": {
                    "kind": "sensor",
                    "id": "imu_accel"
                }
            },
            {
                "name": "gyroscope",
                "unit": "degrees/s",
                "physical": true,
                "target": {
                    "kind": "sensor",
                    "id": "imu_gyro"
                }
            },
            {
                "name": "frame",
                "physical": true,
                "target": {
                    "kind": "camera",
                    "id": "cam"
                }
            },
            {
                "name": "battery_voltage",
                "unit": "V",
                "physical": true,
                "target": {
                    "kind": "emulator"
                },
                "channel_type": "scalar",
                "dim": 1
            }
        ]
    },
    "emulator": {
        "type": "pan_camera_emulator",
        "source": null,
        "parameters": {
            "deadband_threshold": 0.5,
            "noise_stddev": 0.3,
            "battery_full_v": 7.4
        }
    }
}
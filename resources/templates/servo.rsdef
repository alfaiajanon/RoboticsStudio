    },
    "interface": {
        "inputs": [
            {
                "name": "target_angle",
                "unit": "degrees",
                "physical": true,
                "target": {
                    "kind": "joint",
                    "id": "servo_joint"
                }
            }
        ],
        "outputs": [
            {
                "name": "current_angle",
                "unit": "degrees",
                "physical": false,
                "target": {
                    "kind": "sensor",
                    "id": "servo_pos"
                }
            }
        ]
    },
    "emulator": {
        "type": "servo_emulator",
        "source": null,
        "parameters": {
            "noise_stddev": 1.0,
            "delay_ms": 50

                "type": "jointvel",
                "target": {
                    "kind": "joint",
                    "id": "servo_joint"
                }
            }
        ]
    },
    "interface": {
        "inputs": [
            {
                "name": "target_angle",
                "unit": "degrees",
                "physical": true,
                "target": {
                    "kind": "joint",
                    "id": "servo_joint"
                }
            },
            {
                "name": "motor_torque",
                "unit": "N·m",
                "physical": false,
                "target": {
                    "kind": "actuator",
                    "id": "servo_motor"
                },
                "internal": true
            }
        ],
        "outputs": [
            {
                "name": "current_angle",
                "unit": "degrees",
                "physical": false,
                "target": {
                    "kind": "sensor",
                    "id": "servo_pos"
                }
            },
            {
                "name": "gear_velocity",
                "unit": "deg/s",
                "physical": false,
                "target": {
                    "kind": "sensor",
                    "id": "servo_vel"
                },
                "internal": true
            },
            {
                "name": "pot_reading",
                "physical": false,
                "target": {
                    "kind": "emulator"
                },
                "channel_type": "scalar",
                "dim": 1,
                "unit": "degrees",
                "internal": true
            },
            {
                "name": "drive",
                "physical": false,
                "target": {
                    "kind": "emulator"
                },
                "channel_type": "scalar",
                "dim": 1,
                "internal": true
            }
        ]
    },
    "emulator": {
        "type": "servo_emulator",
        "source": null,
        "parameters": {
            "pulse_min_us": 1000,
            "pulse_max_us": 2000,
            "travel_deg": 180,
            "frame_period_ms": 20,
            "deadband_us": 10,
            "proportional_band_deg": 6,
            "stall_torque_nm": 0.176,
            "no_load_speed_dps": 600,
            "rated_voltage": 4.8,
            "supply_voltage": 5.0,
            "pot_noise_deg": 0.3,
            "center_spread_us": 10,
            "gain_spread": 0.03,
            "stall_current_a": 0.65
        },
        "parameter_sources": {
            "pulse_min_us": "datasheet: TowerPro SG90: ~1 ms = -90°, 1.5 ms = 0°, ~2 ms = +90°",
            "pulse_max_us": "datasheet: TowerPro SG90: ~1 ms = -90°, 1.5 ms = 0°, ~2 ms = +90°",
            "travel_deg": "datasheet: TowerPro SG90: ~1 ms = -90°, 1.5 ms = 0°, ~2 ms = +90°",
            "frame_period_ms": "standard hobby servo signal: one pulse every 20 ms (50 Hz)",
            "deadband_us": "datasheet: TowerPro SG90: dead band width 10 µs",
            "proportional_band_deg": "estimate: tuned so a 60° step matches the datasheet speed",
            "stall_torque_nm": "datasheet: TowerPro SG90: 1.8 kgf·cm at 4.8 V (SG90-like template)",
            "no_load_speed_dps": "datasheet: TowerPro SG90: 0.1 s/60° at 4.8 V (SG90-like template)",
            "rated_voltage": "datasheet: TowerPro SG90: voltage of the torque and speed figures",
            "supply_voltage": "assumption: 5 V rail, until the power net exists (plan Phase 2)",
            "pot_noise_deg": "estimate, to be measured (plan task 37)",
            "center_spread_us": "estimate, to be measured (plan task 37)",
            "gain_spread": "estimate, to be measured (plan task 37)",
            "stall_current_a": "estimate: SG90-class servo, 0.6-0.7 A at 4.8-5 V"
        }
    }
}

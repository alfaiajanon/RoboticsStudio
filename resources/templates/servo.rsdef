    "devices": {
        "actuators": [
            {
                "id": "servo_motor",
                "type": "position",
                "target": {
                    "kind": "joint",
                    "id": "servo_joint"
                },
                "ctrlrange": [
                    -90,
                    90
                ],
                "forcerange": [
                    -0.176,
                    0.176
                ],
                "kp": 5.0,
                "kv": 0.5
            }
        ],
        "sensors": [

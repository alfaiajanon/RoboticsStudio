    "emulator": {
        "parameter_sources": {
            "bits_per_channel": "datasheet: OmniVision OV7670, RGB565 output (5/6/5 bits per channel); 6 approximates it",
            "color_gain": "estimate: the warm cast of cheap OV7670 modules without white balance tuning; to be measured",
            "drop_probability": "estimate: occasional lost frames on long jumper wires; to be measured",
            "fps": "estimate: QQVGA on an ESP32/MCU host is typically 10-25 fps (sensor max 30 fps VGA, OV7670 datasheet)",
            "latency_ms": "estimate: one frame of capture plus readout/transfer at 15 fps; to be measured",
            "noise_stddev": "estimate: visible sensor noise of a 0.3 MP sensor indoors (0-255 scale); to be measured"
        },
        "parameters": {
            "bits_per_channel": 6,
            "color_gain": [
                1.05,
                1,
                0.9
            ],
            "drop_probability": 0.02,
            "fps": 15,
            "latency_ms": 60,
            "noise_stddev": 6
        },

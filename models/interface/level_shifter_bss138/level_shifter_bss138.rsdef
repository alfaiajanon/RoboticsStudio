    "emulator": {
        "type": "level_shifter_emulator",
        "parameters": {
            "channels": [
                [
                    "lv1",
                    "hv1"
                ],
                [
                    "lv2",
                    "hv2"
                ],
                [
                    "lv3",
                    "hv3"
                ],
                [
                    "lv4",
                    "hv4"
                ]
            ],
            "max_bitrate": 400000
        },
        "parameter_sources": {
            "channels": "the module's silkscreen: LVn and HVn are one channel (one BSS138 each)",
            "max_bitrate": "estimate: the 10 k pull-ups and ~50-100 pF of wiring give rise times of ~1-2 us: fine for I2C at 400 kHz and UART up to ~400 kbaud (SparkFun BOB-12009 hookup guide: suitable for I2C and serial, not for fast SPI); faster signals need a push-pull shifter (74LVC245, TXB0104)"
        }
    }

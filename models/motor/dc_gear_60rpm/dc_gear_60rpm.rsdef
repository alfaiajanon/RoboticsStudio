{
    "schema": 2,
    "id": "motor_dc_gear_60rpm",
    "meta": {
        "name": "12V 60RPM DC Gear BO Motor (Dual Shaft)",
        "version": "1.0.0",
        "author": "Anon",
        "icon_path": "dc_gear_60rpm.png"
    },
    "resources": {
        "meshes": {
            "mesh_body": "meshes/tt_motor.obj",
            "mesh_shaft": "meshes/shaft.obj"
        },
        "materials": {
            "mat_motor": "textures/tex_tt_motor.png"
        }
    },
    "specs": {
        "voltage_max": 12.0,
        "voltage_min": 3.0,
        "max_torque_nm": 0.15,
        "max_speed_rad": 6.28,
        "weight_kg": 0.035
    },
    "pins": [
        {
            "id": "motor_a",
            "voltage_range": [
                -12.0,
                12.0
            ],
            "description": "Motor terminal A (H-Bridge Output 1)"
        },
        {
            "id": "motor_b",
            "voltage_range": [
                -12.0,
                12.0
            ],
            "description": "Motor terminal B (H-Bridge Output 2)"
        }
    ],
    "kinematics": {
        "default_body": "base",
        "bodies": [
            {
                "id": "base",
                "overrideGeom": false,
                "transform": {
                    "pos": [
                        0,
                        0,
                        0
                    ],
                    "quat": [
                        1,
                        0,
                        0,
                        0
                    ]
                },
                "geoms": [
                    {
                        "id": "base_geom",
                        "type": "mesh",
                        "mesh": "mesh_body",
                        "material": "mat_motor",
                        "mass": 0.03
                    }
                ]
            },
            {
                "id": "axle",
                "overrideGeom": false,
                "transform": {
                    "pos": [
                        0,
                        0.0,
                        0
                    ],
                    "quat": [
                        1,
                        0,
                        0,
                        0
                    ]
                },
                "geoms": [
                    {
                        "id": "axle_geom",
                        "type": "mesh",
                        "mesh": "mesh_shaft",
                        "mass": 0.005
                    }
                ]
            }
        ],
        "joints": [
            {
                "id": "dc_joint",
                "body_a": "base",
                "body_b": "axle",
                "type": "hinge",
                "transform": {
                    "pos": [
                        0,
                        0.0,
                        0
                    ],
                    "quat": [
                        0.7071,
                        0.7071,
                        0,
                        0
                    ]
                },
                "damping": 0.005,
                "armature": 0.01,
                "frictionloss": 0.01,
                "collision": false
            }
        ]
    },
    "connectors": [
        {
            "id": "shaft_left",
            "body": "axle",
            "description": "Left-side flattened TT shaft",
            "mechanics": {
                "snap_angles": [
                    0,
                    180
                ]
            },
            "transform": {
                "pos": [
                    0,
                    -0.02,
                    0
                ],
                "quat": [
                    0.7071,
                    0.7071,
                    0,
                    0
                ]
            }
        },
        {
            "id": "shaft_right",
            "body": "axle",
            "description": "Right-side flattened TT shaft",
            "mechanics": {
                "snap_angles": [
                    0,
                    180
                ]
            },
            "transform": {
                "pos": [
                    0,
                    0.002,
                    0
                ],
                "quat": [
                    0.7071,
                    -0.7071,
                    0,
                    0
                ]
            }
        },
        {
            "id": "chassis_mount_1",
            "body": "base",
            "description": "Right mounting hole",
            "mechanics": {
                "snap_angles": [
                    0,
                    90,
                    180,
                    270
                ]
            },
            "transform": {
                "pos": [
                    0,
                    0,
                    0.0205
                ],
                "quat": [
                    0.7071,
                    -0.7071,
                    0,
                    0
                ]
            }
        },
        {
            "id": "chassis_mount_2",
            "body": "base",
            "description": "Left mounting hole",
            "mechanics": {
                "snap_angles": [
                    0,
                    90,
                    180,
                    270
                ]
            },
            "transform": {
                "pos": [
                    0,
                    -0.019,
                    0.0205
                ],
                "quat": [
                    0.7071,
                    0.7071,
                    0,
                    0
                ]
            }
        }
    ],
    "devices": {
        "actuators": [
            {
                "id": "dc_motor",
                "type": "velocity",
                "target": {
                    "kind": "joint",
                    "id": "dc_joint"
                },
                "ctrlrange": [
                    -6.28,
                    6.28
                ],
                "forcerange": [
                    -0.35,
                    0.35
                ],
                "kv": 10.0
            }
        ],
        "sensors": [
            {
                "id": "dc_vel",
                "type": "jointvel",
                "target": {
                    "kind": "joint",
                    "id": "dc_joint"
                }
            }
        ]
    },
    "interface": {
        "inputs": [
            {
                "name": "target_velocity",
                "unit": "rad/s",
                "physical": true,
                "target": {
                    "kind": "joint",
                    "id": "dc_joint"
                }
            }
        ],
        "outputs": [
            {
                "name": "current_velocity",
                "unit": "rad/s",
                "physical": false,
                "target": {
                    "kind": "sensor",
                    "id": "dc_vel"
                }
            }
        ]
    },
    "emulator": {
        "type": "dc_gear_emulator",
        "source": null,
        "parameters": {
            "max_rpm_at_12v": 60,
            "deadband_pwm": 30,
            "acceleration_delay_ms": 100
        }
    }
}

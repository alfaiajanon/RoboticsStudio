    "emulator": {
        "parameter_sources": {
            "no_load_speed_rpm": "spec sheet: 60 rpm at 12 V measured with the gearbox's friction (generic BO gear motor listing); the line runs through that point, so its friction-free intercept is 64 rpm (harness, 2026-10-19: 58.4 rpm at no load); to be measured (plan task 37)",
            "rated_voltage": "spec sheet: voltage of the speed and torque figures",
            "speed_spread": "estimate: unit-to-unit no-load speed spread (stddev); to be measured",
            "stall_torque_nm": "estimate: the listing's max torque 0.15 N\u00b7m taken as the stall torque at 12 V; to be measured",
            "supply_voltage": "assumption: 12 V supply through an ideal H-bridge, until the power net and driver parts exist (plan Phase 2)"
        },
        "parameters": {
            "no_load_speed_rpm": 64,
            "rated_voltage": 12,
            "speed_spread": 0.05,
            "stall_torque_nm": 0.15,
            "supply_voltage": 12
        },
        "source": {
        },
        "type": "dc_gear_emulator"
    },
    "id": "motor_dc_gear_60rpm",
    "interface": {
        "inputs": [

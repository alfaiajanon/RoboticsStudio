{
    "schema": 3,
    "id": "esp32_cam",
    "meta": {
        "name": "ESP32-CAM (AI-Thinker, OV2640)",
        "version": "1.0.0",
        "author": "Anon",
        "icon_path": "",
        "hint_class": "mcu"
    },
    "specs": {
        "mcu": "ESP32-S (dual core, 240 MHz)",
        "camera": "OmniVision OV2640, 2 MP",
        "psram_mb": 4,
        "logic_voltage": 3.3,
        "current_ma": 180,
        "weight_kg": 0.01,
        "size_mm": [
            27,
            40.5
        ],
        "camera_fovy_deg": "45 (estimate: the stock OV2640 lens is about 66 deg diagonal, ~43-45 deg vertical at 4:3)"
    },
    "pins": [
        {
            "id": "5v",
            "type": "power_out",
            "voltage_range": [
                5,
                5
            ],
            "description": "5 V rail (the board is fed here, e.g. by its USB programmer)"
        },
        {
            "id": "gnd",
            "type": "ground",
            "description": "Ground"
        },
        {
            "id": "io12",
            "type": "gpio",
            "number": 12,
            "caps": [
                "digital",
                "pwm",
                "interrupt",
                "analog",
                "spi_miso"
            ],
            "description": "GPIO12: strapping pin (must be LOW at boot), HSPI MISO, SD card",
            "voltage_range": [
                0,
                3.3
            ]
        },
        {
            "id": "io13",
            "type": "gpio",
            "number": 13,
            "caps": [
                "digital",
                "pwm",
                "interrupt",
                "analog",
                "spi_mosi"
            ],
            "description": "GPIO13: HSPI MOSI, SD card",
            "voltage_range": [
                0,
                3.3
            ]
        },
        {
            "id": "io15",
            "type": "gpio",
            "number": 15,
            "caps": [
                "digital",
                "pwm",
                "interrupt",
                "analog",
                "i2c_scl"
            ],
            "description": "GPIO15: I2C SCL as wired here (Wire.begin(14, 15)), SD card",
            "voltage_range": [
                0,
                3.3
            ]
        },
        {
            "id": "io14",
            "type": "gpio",
            "number": 14,
            "caps": [
                "digital",
                "pwm",
                "interrupt",
                "analog",
                "spi_sck",
                "i2c_sda"
            ],
            "description": "GPIO14: HSPI SCK, I2C SDA as wired here (Wire.begin(14, 15)), SD card",
            "voltage_range": [
                0,
                3.3
            ]
        },
        {
            "id": "io2",
            "type": "gpio",
            "number": 2,
            "caps": [
                "digital",
                "pwm",
                "interrupt",
                "analog"
            ],
            "description": "GPIO2: strapping pin, SD card",
            "voltage_range": [
                0,
                3.3
            ]
        },
        {
            "id": "io4",
            "type": "gpio",
            "number": 4,
            "caps": [
                "digital",
                "pwm",
                "interrupt",
                "analog"
            ],
            "description": "GPIO4: the white flash LED, SD card",
            "voltage_range": [
                0,
                3.3
            ]
        },
        {
            "id": "3v3",
            "type": "power_out",
            "voltage_range": [
                3.3,
                3.3
            ],
            "description": "3.3 V regulator output"
        },
        {
            "id": "io16",
            "type": "gpio",
            "number": 16,
            "caps": [
                "digital",
                "interrupt"
            ],
            "description": "GPIO16: also the PSRAM chip select on this board; avoid",
            "voltage_range": [
                0,
                3.3
            ]
        },
        {
            "id": "gnd2",
            "type": "ground",
            "description": "Ground"
        },
        {
            "id": "io3",
            "type": "gpio",
            "number": 3,
            "caps": [
                "digital",
                "uart_rx"
            ],
            "description": "GPIO3: Serial RX (U0R, the programmer)",
            "voltage_range": [
                0,
                3.3
            ]
        },
        {
            "id": "io1",
            "type": "gpio",
            "number": 1,
            "caps": [
                "digital",
                "uart_tx"
            ],
            "description": "GPIO1: Serial TX (U0T, the programmer)",
            "voltage_range": [
                0,
                3.3
            ]
        },
        {
            "id": "gnd3",
            "type": "ground",
            "description": "Ground"
        },
        {
            "id": "pwdn",
            "type": "digital",
            "number": 32,
            "internal": true,
            "description": "Camera power down (on the board)"
        },
        {
            "id": "xclk",
            "type": "digital",
            "number": 0,
            "internal": true,
            "description": "Camera master clock (GPIO0, also on the header: boot strap) (on the board)"
        },
        {
            "id": "sda",
            "type": "i2c_sda",
            "number": 26,
            "internal": true,
            "description": "Camera SCCB data (on the board)"
        },
        {
            "id": "scl",
            "type": "i2c_scl",
            "number": 27,
            "internal": true,
            "description": "Camera SCCB clock (on the board)"
        },
        {
            "id": "d7",
            "type": "digital",
            "number": 35,
            "internal": true,
            "description": "Camera data Y9 (on the board)"
        },
        {
            "id": "d6",
            "type": "digital",
            "number": 34,
            "internal": true,
            "description": "Camera data Y8 (on the board)"
        },
        {
            "id": "d5",
            "type": "digital",
            "number": 39,
            "internal": true,
            "description": "Camera data Y7 (on the board)"
        },
        {
            "id": "d4",
            "type": "digital",
            "number": 36,
            "internal": true,
            "description": "Camera data Y6 (on the board)"
        },
        {
            "id": "d3",
            "type": "digital",
            "number": 21,
            "internal": true,
            "description": "Camera data Y5 (on the board)"
        },
        {
            "id": "d2",
            "type": "digital",
            "number": 19,
            "internal": true,
            "description": "Camera data Y4 (on the board)"
        },
        {
            "id": "d1",
            "type": "digital",
            "number": 18,
            "internal": true,
            "description": "Camera data Y3 (on the board)"
        },
        {
            "id": "d0",
            "type": "digital",
            "number": 5,
            "internal": true,
            "description": "Camera data Y2 (on the board)"
        },
        {
            "id": "vsync",
            "type": "digital",
            "number": 25,
            "internal": true,
            "description": "Camera VSYNC (on the board)"
        },
        {
            "id": "href",
            "type": "digital",
            "number": 23,
            "internal": true,
            "description": "Camera HREF (on the board)"
        },
        {
            "id": "pclk",
            "type": "digital",
            "number": 22,
            "internal": true,
            "description": "Camera pixel clock (on the board)"
        }
    ],
    "board": {
        "fqbn": "esp32:esp32:esp32cam",
        "logic_voltage": 3.3,
        "adc": {
            "bits": 12,
            "vref": 3.3
        },
        "analog_write": {
            "hz": 1000
        },
        "i2c": {
            "sda": "io14",
            "scl": "io15",
            "default_hz": 100000
        },
        "spi": {
            "sck": "io14",
            "mosi": "io13",
            "miso": "io12",
            "max_hz": 40000000
        },
        "sources": {
            "logic_voltage": "datasheet: ESP32 series, 3.3 V I/O",
            "adc": "arduino-esp32 core: analogRead() 12-bit by default (0..4095); full scale with 11 dB attenuation ~3.1 V, 3.3 V used (estimate)",
            "analog_write": "arduino-esp32 core 3.x: analogWrite() uses LEDC at 1 kHz, 8-bit",
            "i2c": "Wire library default 100 kHz; on this board the camera takes the default pins (21/22), so I2C parts go on 14/15 (common practice)",
            "spi": "datasheet: ESP32 Technical Reference Manual, SPI through the GPIO matrix up to 40 MHz",
            "variant": "esp32:esp32 3.3.12 core: esp32cam builds with the generic variant (boards.txt esp32cam.build.variant=esp32, build.board=ESP32_DEV), variants/esp32/pins_arduino.h; -DESP32=ESP32 from the core's flags/defines. That variant is the generic ESP32's: SDA/SCL (21/22), SPI and most A/T pins are camera or flash pins on an ESP32-CAM, and it has no LED_BUILTIN; ESP32-CAM sketches use the GPIO numbers (Wire.begin(14, 15))",
            "pin_output_ohm": "ESP32 datasheet: VOH >= 0.8 x VDD (2.64 V) at IOH = 40 mA at the strongest drive (level 3); the Arduino core's default drive (level 2, ~20 mA) is about half as strong: ~30 ohm (estimate); 40 mA taken as the per-pin maximum (estimate)",
            "pin_abs_max_ma": "ESP32 datasheet: VOH >= 0.8 x VDD (2.64 V) at IOH = 40 mA at the strongest drive (level 3); the Arduino core's default drive (level 2, ~20 mA) is about half as strong: ~30 ohm (estimate); 40 mA taken as the per-pin maximum (estimate)"
        },
        "variant": {
            "pins": {
                "TX": 1,
                "RX": 3,
                "SDA": 21,
                "SCL": 22,
                "SS": 5,
                "MOSI": 23,
                "MISO": 19,
                "SCK": 18,
                "A0": 36,
                "A3": 39,
                "A4": 32,
                "A5": 33,
                "A6": 34,
                "A7": 35,
                "A10": 4,
                "A11": 0,
                "A12": 2,
                "A13": 15,
                "A14": 13,
                "A15": 12,
                "A16": 14,
                "A17": 27,
                "A18": 25,
                "A19": 26,
                "T0": 4,
                "T1": 0,
                "T2": 2,
                "T3": 15,
                "T4": 13,
                "T5": 12,
                "T6": 14,
                "T7": 27,
                "T8": 33,
                "T9": 32,
                "DAC1": 25,
                "DAC2": 26
            },
            "defines": [
                "ARDUINO=10607",
                "ESP32=ESP32",
                "ARDUINO_ESP32_DEV",
                "ARDUINO_ARCH_ESP32",
                "ARDUINO_BOARD=\"ESP32_DEV\"",
                "ARDUINO_VARIANT=\"esp32\"",
                "F_CPU=240000000L"
            ]
        },
        "pin_output_ohm": 30,
        "pin_abs_max_ma": 40
    },
    "power": {
        "supplies": [
            {
                "pin": "5v",
                "kind": "usb",
                "voltage": 5.0,
                "r_internal_ohm": 0.5,
                "hold_current_a": 0.5
            }
        ],
        "regulators": [
            {
                "id": "reg_3v3",
                "in": "5v",
                "out": "3v3",
                "kind": "linear",
                "v_out": 3.3,
                "dropout_v": 1.1,
                "i_max_a": 0.8,
                "i_quiescent_ma": 5
            }
        ],
        "loads": [
            {
                "pin": "3v3",
                "current_ma": 180
            }
        ],
        "brownout": {
            "rail": "3v3",
            "threshold_v": 2.43,
            "hysteresis_v": 0.05,
            "restart_ms": 300
        },
        "sources": {
            "supplies.5v": "estimate: fed through an ESP32-CAM-MB / USB-serial adapter from a USB 2.0 port (500 mA budget); cable and adapter ~0.5 ohm",
            "regulators.reg_3v3": "datasheet: AMS1117-3.3 (on the AI-Thinker board): dropout 1.1 V typ / 1.3 V max at 800 mA, ~5 mA quiescent",
            "loads.3v3": "datasheet: AI-Thinker ESP32-CAM spec, 180 mA at 5 V with the flash LED off (camera running); Wi-Fi peaks not modelled",
            "brownout": "datasheet: ESP-IDF brownout detector, default level 0 ~2.43 V; hysteresis is an estimate; restart ~300 ms (ROM + bootloader + app start) is an estimate"
        }
    },
    "resources": {
        "meshes": {},
        "materials": {}
    },

    "connectors": [
        {
            "id": "general",
            "body": "base",
            "description": "Mount on the back of the board (lens faces away), where an OV7670 would mount",
            "mechanics": {
                "snap_angles": [
                    0,
                    90,
                    180,
                    270
                ]
            },
            "transform": {
                "pos": [
                    0,
                    0,
                    0.0002
                ],
                "quat": [
                    6.123233995736766e-17,
                    0,
                    0,
                    1
                ]
            }
        }
    ],
    "devices": {
        "cameras": [
            {
                "id": "cam",
                "type": "rgb",
                "fovy": 45,
                "resolution": [
                    160,
                    120
                ],
                "target": {
                    "kind": "site",
                    "id": "lens_tip"
                }
            }
        ]
    },
    "interface": {
        "inputs": [],
        "outputs": [
            {
                "name": "image",
                "physical": true,
                "target": {
                    "kind": "camera",
                    "id": "cam"
                }
            }
        ]
    },
    "emulator": {
        "type": "camera_emulator",
        "source": {},
        "parameters": {
            "bits_per_channel": 6,
            "color_gain": [
                1.0,
                1.0,
                0.95
            ],
            "drop_probability": 0.01,
            "fps": 15,
            "latency_ms": 60,
            "noise_stddev": 5
        },
        "parameter_sources": {
            "bits_per_channel": "datasheet: OmniVision OV2640, RGB565 output (5/6/5 bits); 6 approximates it",
            "color_gain": "estimate: OV2640 auto white balance leaves a slight cast; to be measured",
            "drop_probability": "estimate: occasional lost frames (on-board flex cable, fewer than jumper wires); to be measured",
            "fps": "estimate: QQVGA RGB565 on an ESP32-CAM with one frame buffer, 15-25 fps reported",
            "latency_ms": "estimate: one frame of capture plus readout at 15 fps; to be measured",
            "noise_stddev": "estimate: visible noise of a 2 MP 1/4\" sensor indoors (0-255 scale); to be measured"
        }
    }
}

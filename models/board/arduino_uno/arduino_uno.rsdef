            ]
        },
        {
            "id": "5v",
            "type": "power_out",
            "voltage_range": [
                5,
                5
            ],
            "description": "5 V rail (USB or the on-board regulator)"
        },
        {
            "id": "3v3",
            "type": "power_out",
            "voltage_range": [
                3.3,
                3.3
            ],
            "description": "3.3 V regulator output (50 mA)"
        },
        {
            "id": "gnd",
            "type": "ground",
            "description": "Ground (power header)"
        },
        {
            "id": "gnd2",
            "type": "ground",
            "description": "Ground (power header)"
        },
        {
            "id": "gnd3",
            "type": "ground",
            "description": "Ground (next to D13)"
        },
        {
            "id": "vin",
            "type": "power",
            "voltage_range": [
                7,
                12
            ],
            "description": "Supply input to the regulator (barrel jack)"
        }
    ],
    "board": {
        "fqbn": "arduino:avr:uno",
        "logic_voltage": 5,
        "adc": {
            "bits": 10,
            "vref": 5
        },
        "analog_write": {
            "hz": 490,
            "pins": {
                "d5": 980,
                "d6": 980
            }
        },
        "i2c": {
            "sda": "a4",
            "scl": "a5",
            "default_hz": 100000
        },
        "spi": {
            "sck": "d13",
            "mosi": "d11",
            "miso": "d12",
            "max_hz": 8000000
        },
        "sources": {
            "logic_voltage": "datasheet: Arduino Uno R3 product reference (A000066): 5 V operating voltage",
            "adc": "datasheet: ATmega328P, 10-bit ADC; Arduino core default reference AVcc = 5 V",
            "analog_write": "Arduino AVR core (wiring.c): timers 1 and 2 at 16 MHz/64/510 = 490 Hz, timer 0 (pins 5, 6) fast PWM 976.6 Hz",
            "i2c": "Arduino Wire library: TWI_FREQ 100 kHz by default",
            "spi": "datasheet: ATmega328P, SPI clock up to f_osc/2 = 8 MHz",
            "variant": "arduino:avr 1.8.8 core: variants/standard/pins_arduino.h (pin names) and boards.txt/platform.txt (uno.build.board=AVR_UNO: -DARDUINO_AVR_UNO -DARDUINO_ARCH_AVR, -DARDUINO=10607 from arduino-cli, F_CPU 16 MHz). A6/A7 exist in the variant but not on the Uno's header",
            "pin_output_ohm": "ATmega328P datasheet: absolute maximum DC current per I/O pin 40 mA (200 mA through VCC/GND); DC characteristics VOH >= 4.0 V at IOH = 20 mA, VCC = 5 V (worst case, 85 C: <= 50 ohm); the typical VOH/VOL-vs-current curves at 25 C give ~0.5 V at 20 mA, ~25 ohm (estimate read from the curves). Above 40 mA a real pin is damaged (not simulated)",
            "pin_abs_max_ma": "ATmega328P datasheet: absolute maximum DC current per I/O pin 40 mA (200 mA through VCC/GND); DC characteristics VOH >= 4.0 V at IOH = 20 mA, VCC = 5 V (worst case, 85 C: <= 50 ohm); the typical VOH/VOL-vs-current curves at 25 C give ~0.5 V at 20 mA, ~25 ohm (estimate read from the curves). Above 40 mA a real pin is damaged (not simulated)"
        },
        "variant": {
            "pins": {
                "SS": 10,
                "MOSI": 11,
                "MISO": 12,
                "SCK": 13,
                "SDA": 18,
                "SCL": 19,
                "LED_BUILTIN": 13,
                "A0": 14,
                "A1": 15,
                "A2": 16,
                "A3": 17,
                "A4": 18,
                "A5": 19,
                "A6": 20,
                "A7": 21
            },
            "defines": [
                "ARDUINO=10607",
                "ARDUINO_AVR_UNO",
                "ARDUINO_ARCH_AVR",
                "F_CPU=16000000L"
            ]
        },
        "pin_output_ohm": 25,
        "pin_abs_max_ma": 40
    },
    "power": {
        "supplies": [
            {
                "pin": "5v",
                "kind": "usb",
                "voltage": 5.0,
                "r_internal_ohm": 0.5,
                "hold_current_a": 0.5
            }
        ],
        "regulators": [
            {
                "id": "reg_5v",
                "in": "vin",
                "out": "5v",
                "kind": "linear",
                "v_out": 5.0,
                "dropout_v": 1.1,
                "i_max_a": 1.0,
                "i_quiescent_ma": 5
            },
            {
                "id": "reg_3v3",
                "in": "5v",
                "out": "3v3",
                "kind": "linear",
                "v_out": 3.3,
                "dropout_v": 0.3,
                "i_max_a": 0.15
            }
        ],
        "loads": [
            {
                "pin": "5v",
                "current_ma": 45
            }
        ],
        "brownout": {
            "rail": "5v",
            "threshold_v": 2.7,
            "hysteresis_v": 0.05,
            "restart_ms": 65
        },
        "sources": {
            "supplies.5v": "datasheet: Arduino Uno R3 schematic, USB 5 V through the MF-MSMF050 polyfuse (Bourns: hold 0.5 A, trip 1.0 A, 0.15-1.0 ohm) and an FDN340P switch; 0.5 ohm with a typical USB cable is an estimate",
            "regulators.reg_5v": "datasheet: NCP1117ST50T3G (on the R3 schematic): 1 A, dropout ~1.1 V at full load, ~5 mA quiescent (typ)",
            "regulators.reg_3v3": "datasheet: LP2985-33DBVR (on the R3 schematic): 150 mA, dropout ~0.3 V at 150 mA; Arduino rates the 3V3 pin at 50 mA",
            "loads.5v": "estimate: an idle Uno R3 (ATmega328P + ATmega16U2 + power LED) is commonly measured at 45-50 mA",
            "brownout": "datasheet: ATmega328P V_BOT 2.5-2.9 V (typ 2.7 V) at BODLEVEL 2.7 V, the Uno's extended fuse 0xFD; hysteresis 50 mV; start-up 16K CK + 65 ms (low fuse 0xFF); Optiboot only runs after an external reset"
        }
    },

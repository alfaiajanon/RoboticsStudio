            }
        ],
        "sources": {
            "regulators.buck": "datasheet: TI LM2596 (3 A rated, 4.5-40 V in, ~1.5 V minimum headroom at 3 A, ~5 mA quiescent; switch current limit 3.6-6.9 A, typ 4.5 A, where the output folds back); efficiency ~85 % read off its 5 V-out curve; output set per instance in the Inspector (the module's trimmer)"
        }

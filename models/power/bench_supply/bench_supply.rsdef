        "hint_class": "battery"
    },
    "specs": {
        "type": "adjustable lab supply, constant voltage / constant current",
        "note": "the supply stands off the robot; the part is the terminal block its leads go to",
        "weight_kg": 0.005
    },
    "pins": [
        {
            "id": "plus",
            "type": "power_out",
            "voltage_range": [
                0,
                30
            ],
            "description": "Supply + (red lead)"
        },
        {
            "id": "minus",
            "type": "ground",
            "description": "Supply - (black lead)"
        }
    ],
    "power": {
        "supplies": [
            {
                "pin": "plus",
                "kind": "supply",
                "voltage": 5.0,
                "r_internal_ohm": 0.0,
                "current_limit_a": 3.0
            }
        ],
        "sources": {
            "supplies.plus": "an ideal lab supply: voltage and current limit set per instance in the Inspector (defaults 5.0 V, 3 A); leads assumed ideal"
        }
    },

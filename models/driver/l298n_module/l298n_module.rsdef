{
    "schema": 3,
    "id": "driver_l298n",
    "meta": {
        "name": "L298N dual H-bridge motor driver module",
        "version": "1.0.0",
        "author": "Anon",
        "icon_path": "",
        "hint_class": "part"
    },
    "specs": {
        "chip": "L298N (+ 78M05 regulator)",
        "motor_supply_v": [
            5,
            35
        ],
        "current_per_channel_a": 2,
        "weight_kg": 0.03,
        "size_mm": [
            43,
            43,
            27
        ]
    },
    "pins": [
        {
            "id": "vs",
            "type": "power",
            "description": "+12V screw terminal: motor supply VS (5-35 V on the module; feeds the 78M05 too)",
            "voltage_range": [
                5,
                35
            ]
        },
        {
            "id": "gnd",
            "type": "ground",
            "description": "GND screw terminal (common with the board's GND)"
        },
        {
            "id": "5v",
            "type": "power_out",
            "description": "+5V screw terminal: the on-board 78M05's output while the 5V-EN jumper is fitted (VS <= 12 V); can feed a board",
            "voltage_range": [
                4.75,
                5.25
            ]
        },
        {
            "id": "ena",
            "type": "pwm",
            "description": "ENA: channel A enable (PWM here for speed once its jumper is removed)",
            "voltage_range": [
                0,
                7
            ]
        },
        {
            "id": "in1",
            "type": "digital",
            "description": "IN1: drives OUT1 HIGH/LOW",
            "voltage_range": [
                0,
                7
            ]
        },
        {
            "id": "in2",
            "type": "digital",
            "description": "IN2: drives OUT2 HIGH/LOW",
            "voltage_range": [
                0,
                7
            ]
        },
        {
            "id": "in3",
            "type": "digital",
            "description": "IN3: drives OUT3 HIGH/LOW",
            "voltage_range": [
                0,
                7
            ]
        },
        {
            "id": "in4",
            "type": "digital",
            "description": "IN4: drives OUT4 HIGH/LOW",
            "voltage_range": [
                0,
                7
            ]
        },
        {
            "id": "enb",
            "type": "pwm",
            "description": "ENB: channel B enable",
            "voltage_range": [
                0,
                7
            ]
        },
        {
            "id": "out1",
            "type": "motor_out",
            "description": "OUT1 (motor A)"
        },
        {
            "id": "out2",
            "type": "motor_out",
            "description": "OUT2 (motor A)"
        },
        {
            "id": "out3",
            "type": "motor_out",
            "description": "OUT3 (motor B)"
        },
        {
            "id": "out4",
            "type": "motor_out",
            "description": "OUT4 (motor B)"
        }
    ],

    "power": {
        "regulators": [
            {
                "id": "reg_5v",
                "in": "vs",
                "out": "5v",
                "kind": "linear",
                "v_out": 5.0,
                "dropout_v": 2.0,
                "i_max_a": 0.5,
                "i_quiescent_ma": 6
            }
        ],
        "loads": [
            {
                "pin": "vs",
                "current_ma": 13,
                "min_v": 4.5
            },
            {
                "pin": "5v",
                "current_ma": 24
            }
        ],
        "sources": {
            "regulators.reg_5v": "78M05 (500 mA) datasheet: 5 V, ~2 V dropout, ~6 mA quiescent; the module's 5V-EN jumper fitted (not modelled: above 12 V VS the module asks to remove it)",
            "loads.vs": "ST L298 datasheet (Dual Full-Bridge Driver), electrical characteristics at 25 C (copies at ece.nus.edu.sg, makerguides.com): quiescent supply current IS (VS pin) 13 mA typ with EN high and inputs low (50 mA with inputs high); VS must exceed VIH + 2.5 V (min_v ~4.5 V, estimate)",
            "loads.5v": "ST L298 datasheet (Dual Full-Bridge Driver), electrical characteristics at 25 C (copies at ece.nus.edu.sg, makerguides.com): logic supply current ISS 24 mA typ (EN high, inputs low)"
        }
    },
    "emulator": {
        "type": "hbridge_emulator",
        "parameters": {
            "truth_table": "l298",
            "high_v0": 0.7,
            "high_r": 0.65,
            "low_v0": 0.7,
            "low_r": 0.5,
            "ideal_supply_v": 12,
            "channel_max_a": 2.0
        },
        "parameter_sources": {
            "truth_table": "ST L298 datasheet (Dual Full-Bridge Driver), electrical characteristics at 25 C (copies at ece.nus.edu.sg, makerguides.com): function table: EN low = fast motor stop (outputs off); EN high: IN1 = IN2 = brake (fast stop), IN1 H / IN2 L = forward",
            "high_v0": "ST L298 datasheet (Dual Full-Bridge Driver), electrical characteristics at 25 C (copies at ece.nus.edu.sg, makerguides.com): source saturation VCEsat(H) 1.35 V typ at 1 A, 2.0 V typ at 2 A -> a line 0.70 V + 0.65 ohm x I",
            "high_r": "ST L298 datasheet (Dual Full-Bridge Driver), electrical characteristics at 25 C (copies at ece.nus.edu.sg, makerguides.com): see high_v0",
            "low_v0": "ST L298 datasheet (Dual Full-Bridge Driver), electrical characteristics at 25 C (copies at ece.nus.edu.sg, makerguides.com): sink saturation VCEsat(L) 1.2 V typ at 1 A, 1.7 V typ at 2 A -> 0.70 V + 0.5 ohm x I (total drop at 1 A: 2.55 V, datasheet range 1.80-3.2 V)",
            "low_r": "ST L298 datasheet (Dual Full-Bridge Driver), electrical characteristics at 25 C (copies at ece.nus.edu.sg, makerguides.com): see low_v0",
            "ideal_supply_v": "assumption: VS when the power model isn't running (no Real-level wiring)",
            "channel_max_a": "ST L298 datasheet: DC output current 2 A per bridge (repetitive peak 2.5 A, non-repetitive 3 A); the module's heatsink is rated for the same"
        },
        "source": {}
    }
}

        ],
        "sources": {
            "loads.vm": "Toshiba TB6612FNG datasheet (copies at tams-www.informatik.uni-hamburg.de, faculty-web.msoe.edu): VM operating range 2.5-13.5 V; its own draw is negligible next to the motor's",
            "loads.vcc": "Toshiba TB6612FNG datasheet (copies at tams-www.informatik.uni-hamburg.de, faculty-web.msoe.edu): ICC 1.1 mA typ at 3 V, 1.5 mA typ at 5.5 V (taken: 1.5 mA); operating range 2.7-5.5 V"
        }
    },
    "emulator": {
        "type": "hbridge_emulator",
        "parameters": {
            "truth_table": "tb6612",
            "high_v0": 0.0,
            "high_r": 0.25,
            "low_v0": 0.0,
            "low_r": 0.25,
            "ideal_supply_v": 12,
            "channel_max_a": 1.2
        },
        "parameter_sources": {
            "truth_table": "Toshiba TB6612FNG datasheet (copies at tams-www.informatik.uni-hamburg.de, faculty-web.msoe.edu): H-SW control function: IN1/IN2 H/H short brake, L/H CCW, H/L CW, L/L stop (high impedance); PWM L = short brake; STBY L = standby (off)",
            "high_v0": "Toshiba TB6612FNG datasheet (copies at tams-www.informatik.uni-hamburg.de, faculty-web.msoe.edu): MOSFET outputs: no fixed drop",
            "high_r": "Toshiba TB6612FNG datasheet (copies at tams-www.informatik.uni-hamburg.de, faculty-web.msoe.edu): output ON resistance 0.5 ohm upper + lower typ (Vsat 0.5 V typ at 1 A, VM = 5 V): 0.25 ohm each",
            "low_v0": "Toshiba TB6612FNG datasheet (copies at tams-www.informatik.uni-hamburg.de, faculty-web.msoe.edu): MOSFET outputs: no fixed drop",
            "low_r": "Toshiba TB6612FNG datasheet (copies at tams-www.informatik.uni-hamburg.de, faculty-web.msoe.edu): see high_r",
            "ideal_supply_v": "assumption: VM when the power model isn't running (no Real-level wiring)",
            "channel_max_a": "Toshiba TB6612FNG datasheet: output current 1.2 A average per channel (3.2 A peak); the application note recommends 1.0 A or less continuous at VM >= 4.5 V"
        },
        "source": {}
    }

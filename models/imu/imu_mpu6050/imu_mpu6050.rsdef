{
    "schema": 2,
    "id": "sensor_mpu6050",
    "meta": {
        "name": "MPU-6050 IMU Sensor",
        "version": "1.0.0",
        "author": "Anon",
        "icon_path": "mpu6050.png"
    },
    "resources": {
        "meshes": {
            "mesh_body": "meshes/mpu6050.obj"
        },
        "materials": {
            "mat_body": "textures/mpu6050-2.png"
        }
    },
    "specs": {
        "voltage_max": 3.3,
        "voltage_min": 2.3,
        "current_ma": 3.9,
        "weight_kg": 0.005
    },
    "pins": [
        {
            "id": "vcc",
            "voltage_range": [
                2.3,
                3.3
            ],
            "description": "Power input pin for IMU sensor"
        },
        {
            "id": "gnd",
            "description": "Ground pin for IMU sensor"
        },
        {
            "id": "scl",
            "description": "I2C clock pin for communication"
        },
        {
            "id": "sda",
            "description": "I2C data pin for communication"
        },
        {
            "id": "xda",
            "description": "Auxiliary I2C data pin (not commonly used)"
        },
        {
            "id": "xcl",
            "description": "Auxiliary I2C clock pin (not commonly used)"
        },
        {
            "id": "ad0",
            "description": "I2C address selection pin (connect to GND for 0x68, VCC for 0x69)"
        },
        {
            "id": "int",
            "description": "Interrupt pin for motion detection"
        }
    ],
    "kinematics": {
        "default_body": "base",
        "bodies": [
            {
                "id": "base",
                "overrideGeom": false,
                "transform": {
                    "pos": [
                        0,
                        0,
                        0
                    ],
                    "quat": [
                        1,
                        0,
                        0,
                        0
                    ]
                },
                "geoms": [
                    {
                        "id": "base_geom",
                        "type": "mesh",
                        "mesh": "mesh_body",
                        "material": "mat_body",
                        "mass": 0.005
                    }
                ],
                "sites": [
                    {
                        "id": "imu",
                        "transform": {
                            "pos": [
                                0,
                                0,
                                0
                            ],
                            "quat": [
                                1,
                                0,
                                0,
                                0
                            ]
                        }
                    }
                ]
            }
        ],
        "joints": []
    },
    "connectors": [
        {
            "id": "connector_1",
            "body": "base",
            "description": "Connector 1 for mounting the MPU-6050 sensor",
            "mechanics": {
                "snap_angles": [
                    0,
                    180
                ]
            },
            "transform": {
                "pos": [
                    0.008,
                    0.0058,
                    -0.0015
                ],
                "quat": [
                    0,
                    1,
                    0,
                    0
                ]
            }
        },
        {
            "id": "connector_2",
            "body": "base",
            "description": "Connector 2 for mounting the MPU-6050 sensor",
            "mechanics": {
                "snap_angles": [
                    0,
                    180
                ]
            },
            "transform": {
                "pos": [
                    -0.008,
                    0.0058,
                    -0.0015
                ],
                "quat": [
                    0,
                    1,
                    0,
                    0
                ]
            }
        }
    ],
    "devices": {
        "sensors": [
            {
                "id": "imu_accel",
                "type": "accelerometer",
                "target": {
                    "kind": "site",
                    "id": "imu"
                }
            },
            {
                "id": "imu_gyro",
                "type": "gyro",
                "target": {
                    "kind": "site",
                    "id": "imu"
                }
            }
        ]
    },
    "interface": {
        "inputs": [],
        "outputs": [
            {
                "name": "acceleration",
                "unit": "m/s^2",
                "physical": true,
                "target": {
                    "kind": "sensor",
                    "id": "imu_accel"
                },
                "componentLabels": [
                    "x",
                    "y",
                    "z"
                ]
            },
            {
                "name": "gyroscope",
                "unit": "degrees/s",
                "physical": true,
                "target": {
                    "kind": "sensor",
                    "id": "imu_gyro"
                },
                "componentLabels": [
                    "x",
                    "y",
                    "z"
                ]
            }
        ]
    },
    "emulator": {
        "type": "imu_emulator",
        "source": null,
        "parameters": {
            "noise_stddev": 1.0,
            "delay_ms": 50
        }
    }
}

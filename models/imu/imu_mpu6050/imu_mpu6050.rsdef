{
    "schema": 3,
    "id": "sensor_mpu6050",
    "meta": {
        "hint_class": "sensor",
        "name": "MPU-6050 IMU Sensor",
        "version": "1.0.0",
        "author": "Anon",
        "icon_path": "mpu6050.png"
    },
    "resources": {
        "meshes": {
            "mesh_body": "meshes/mpu6050.obj"
        },
        "materials": {
            "mat_body": "textures/mpu6050-2.png"
        }
    },
    "specs": {
        "voltage_max": 3.3,
        "voltage_min": 2.3,
        "current_ma": 3.9,
        "weight_kg": 0.005
    },
    "pins": [
        {
            "id": "vcc",
            "type": "power",
            "voltage_range": [
                2.3,
                3.3
            ],
            "description": "Power input pin for IMU sensor"
        },
        {
            "id": "gnd",
            "type": "ground",
            "description": "Ground pin for IMU sensor"
        },
        {
            "id": "scl",
            "type": "i2c_scl",
            "description": "I2C clock pin for communication"
        },
        {
            "id": "sda",
            "type": "i2c_sda",
            "description": "I2C data pin for communication"
        },
        {
            "id": "xda",
            "description": "Auxiliary I2C data pin (not commonly used)"
        },
        {
            "id": "xcl",
            "description": "Auxiliary I2C clock pin (not commonly used)"
        },
        {
            "id": "ad0",
            "description": "I2C address selection pin (connect to GND for 0x68, VCC for 0x69)"
        },
        {
            "id": "int",
            "description": "Interrupt pin for motion detection"
        }
    ],
    "kinematics": {
        "default_body": "base",
        "bodies": [
            {
                "id": "base",
                "overrideGeom": false,
                "transform": {
                    "pos": [
                        0,
                        0,
                        0
                    ],
                    "quat": [
                        1,
                        0,
                        0,
                        0
                    ]
                },
                "geoms": [
                    {
                        "id": "base_geom",
                        "type": "mesh",
                        "mesh": "mesh_body",
                        "material": "mat_body",
                        "mass": 0.005
                    }
                ],
                "sites": [
                    {
                        "id": "imu",
                        "transform": {
                            "pos": [
                                0,
                                0,
                                0
                            ],
                            "quat": [
                                1,
                                0,
                                0,
                                0
                            ]
                        }
                    }
                ]
            }
        ],
        "joints": []
    },
    "connectors": [
        {
            "id": "connector_1",
            "body": "base",
            "description": "Connector 1 for mounting the MPU-6050 sensor",
            "mechanics": {
                "snap_angles": [
                    0,
                    180
                ]
            },
            "transform": {
                "pos": [
                    0.008,
                    0.0058,
                    -0.0015
                ],
                "quat": [
                    0,
                    1,
                    0,
                    0
                ]
            }
        },
        {
            "id": "connector_2",
            "body": "base",
            "description": "Connector 2 for mounting the MPU-6050 sensor",
            "mechanics": {
                "snap_angles": [
                    0,
                    180
                ]
            },
            "transform": {
                "pos": [
                    -0.008,
                    0.0058,
                    -0.0015
                ],
                "quat": [
                    0,
                    1,
                    0,
                    0
                ]
            }
        }
    ],
    "devices": {
        "sensors": [
            {
                "id": "imu_accel",
                "type": "accelerometer",
                "target": {
                    "kind": "site",
                    "id": "imu"
                }
            },
            {
                "id": "imu_gyro",
                "type": "gyro",
                "target": {
                    "kind": "site",
                    "id": "imu"
                }
            }
        ]
    },
    "interface": {
        "inputs": [],
        "outputs": [
            {
                "name": "acceleration",
                "unit": "m/s^2",
                "physical": false,
                "target": {
                    "kind": "sensor",
                    "id": "imu_accel"
                },
                "componentLabels": [
                    "x",
                    "y",
                    "z"
                ]
            },
            {
                "name": "gyroscope",
                "unit": "degrees/s",
                "physical": false,
                "target": {
                    "kind": "sensor",
                    "id": "imu_gyro"
                },
                "componentLabels": [
                    "x",
                    "y",
                    "z"
                ]
            },
            {
                "name": "accel_reading",
                "unit": "g",
                "physical": true,
                "target": {
                    "kind": "emulator"
                },
                "channel_type": "vector",
                "dim": 3,
                "componentLabels": [
                    "x",
                    "y",
                    "z"
                ]
            },
            {
                "name": "gyro_reading",
                "unit": "\u00b0/s",
                "physical": true,
                "target": {
                    "kind": "emulator"
                },
                "channel_type": "vector",
                "dim": 3,
                "componentLabels": [
                    "x",
                    "y",
                    "z"
                ]
            }
        ]
    },
    "emulator": {
        "type": "imu_emulator",
        "source": null,
        "parameters": {
            "accel_noise_density_ug": 400,
            "gyro_noise_density_dps": 0.005,
            "accel_bias_spread_mg": 25,
            "gyro_bias_spread_dps": 5,
            "accel_bias_walk_mg": 0.05,
            "gyro_bias_walk_dps": 0.01,
            "scale_spread": 0.01,
            "ad0_high": 0
        },
        "parameter_sources": {
            "accel_noise_density_ug": "datasheet: InvenSense MPU-6000/MPU-6050 Product Specification rev 3.4, accelerometer noise power spectral density 400 \u00b5g/\u221aHz",
            "gyro_noise_density_dps": "datasheet: InvenSense MPU-6000/MPU-6050 Product Specification rev 3.4, gyroscope rate noise spectral density 0.005 \u00b0/s/\u221aHz",
            "accel_bias_spread_mg": "datasheet: InvenSense MPU-6000/MPU-6050 Product Specification rev 3.4, zero-G initial calibration tolerance \u00b150 mg (X, Y), \u00b180 mg (Z); estimate: stddev 25 mg on every axis",
            "gyro_bias_spread_dps": "datasheet: InvenSense MPU-6000/MPU-6050 Product Specification rev 3.4, initial ZRO tolerance \u00b120 \u00b0/s; estimate: stddev 5 \u00b0/s (typical units read a few \u00b0/s); to be measured",
            "accel_bias_walk_mg": "estimate: bias drift is not in the datasheet; to be measured (plan task 37)",
            "gyro_bias_walk_dps": "estimate: bias drift is not in the datasheet; to be measured (plan task 37)",
            "scale_spread": "datasheet: InvenSense MPU-6000/MPU-6050 Product Specification rev 3.4, sensitivity scale factor tolerance \u00b13 %; estimate: stddev 1 %",
            "ad0_high": "wiring: AD0 tied LOW, address 0x68 (1 = AD0 HIGH, 0x69)"
        }
    }
}

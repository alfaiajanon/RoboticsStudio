                            0.017,
                            0.001
                        ],
                        "pos": [
                            0,
                            0,
                            0
                        ],
                        "quat": [
                            1,
                            0,
                            0,
                            0
                        ],
                        "mass": 0.008
                    },
                    {
                        "id": "screen",
                        "type": "box",
                        "size": [
                            0.017,
                            0.0136,
                            0.0003
                        ],
                        "pos": [
                            0,
                            0,
                            0.0013
                        ],
                        "quat": [
                            1,
                            0,
                            0,
                            0
                        ],
                        "mass": 0.002
                    }
                ],
                "sites": []
            }
        ],
        "joints": []
    },
    "connectors": [
        {
            "id": "back",
            "body": "base",
            "description": "Mount on the back of the board (screen faces away)",

{
    "schema": 2,
    "id": "display_tft_160x128",
    "meta": {
        "name": "RGB TFT Display (160x128)",
        "version": "1.0.0",
        "author": "Anon"
    },
    "resources": {
        "meshes": {},
        "materials": {}
    },
    "specs": {
        "voltage_max": 3.3,
        "current_ma": 40,
        "weight_kg": 0.01,
        "diagonal_in": 1.8
    },
    "pins": [
        {
            "id": "vcc",
            "voltage_range": [
                3.0,
                3.3
            ],
            "description": "Power input"
        },
        {
            "id": "gnd",
            "description": "Ground"
        },
        {
            "id": "sck",
            "description": "SPI clock"
        },
        {
            "id": "mosi",
            "description": "SPI data"
        },
        {
            "id": "cs",
            "description": "SPI chip select"
        },
        {
            "id": "dc",
            "description": "Data/command select"
        },
        {
            "id": "rst",
            "description": "Reset"
        },
        {
            "id": "led",
            "description": "Backlight"
        }
    ],
    "kinematics": {

    "devices": {
        "actuators": [
            {
                "id": "servo_motor",
                "type": "position",
                "target": {
                    "kind": "joint",
                    "id": "servo_joint"
                },
                "ctrlrange": [
                    -90,
                    90
                ],
                "forcerange": [
                    -1.08,
                    1.08
                ],
                "kp": 20,
                "kv": 0.3
            }
        ],
        "sensors": [
            {
                "id": "servo_pos",
                "type": "jointpos",
                "target": {
                    "kind": "joint",
                    "id": "servo_joint"
                }
            },
            {
                "id": "sensor_real_pos",
                "type": "tendonpos",
                "target": {
                    "kind": "tendon",
                    "id": "output_tendon"
                }
            }
        ]
    },
    "interface": {
        "inputs": [
            {
                "name": "target_angle",
                "unit": "degrees",
                "domain": {
                    "type": "ranged",
                    "parameters": {
                        "min": -90,
                        "max": 90
                    }
                },
                "physical": true,
                "target": {
                    "kind": "joint",
                    "id": "servo_joint"
                }
            }
        ],
        "outputs": [
            {
                "name": "current_angle",
                "unit": "degrees",
                "physical": false,
                "target": {
                    "kind": "sensor",
                    "id": "servo_pos"
                }
            },
            {
                "name": "current_angle_real",
                "unit": "degrees",
                "physical": true,
                "target": {
                    "kind": "sensor",
                    "id": "sensor_real_pos"
                }
            }
        ]
    },
    "emulator": {
        "type": "servo_emulator",
        "source": null,
        "parameters": {
            "noise_stddev": 0.2,
            "deadband_threshold": 1
        }
    }
}

    "devices": {
        "actuators": [
            {
                "id": "servo_motor",
                "type": "motor",
                "target": {
                    "kind": "joint",
                    "id": "servo_joint"
                },
                "ctrlrange": [
                    -1.62,
                    1.62
                ],
                "forcerange": [
                    -1.62,
                    1.62
                ]
            }
        ],
        "sensors": [
            {
                "id": "servo_pos",
                "type": "jointpos",
                "target": {
                    "kind": "joint",
                    "id": "servo_joint"
                }
            },
            {
                "id": "sensor_real_pos",
                "type": "tendonpos",
                "target": {
                    "kind": "tendon",
                    "id": "output_tendon"
                }
            },
            {
                "id": "servo_vel",
                "type": "jointvel",
                "target": {
                    "kind": "joint",
                    "id": "servo_joint"
                }
            }
        ]
    },
    "interface": {
        "inputs": [
            {
                "name": "target_angle",
                "unit": "degrees",
                "domain": {
                    "type": "ranged",
                    "parameters": {
                        "min": -90,
                        "max": 90
                    }
                },
                "physical": true,
                "target": {
                    "kind": "joint",
                    "id": "servo_joint"
                }
            },
            {
                "name": "motor_torque",
                "unit": "N·m",
                "physical": false,
                "target": {
                    "kind": "actuator",
                    "id": "servo_motor"
                },
                "internal": true
            }
        ],
        "outputs": [
            {
                "name": "current_angle",
                "unit": "degrees",
                "physical": false,
                "target": {
                    "kind": "sensor",
                    "id": "servo_pos"
                },
                "internal": true
            },
            {
                "name": "current_angle_real",
                "unit": "degrees",
                "physical": true,
                "target": {
                    "kind": "sensor",
                    "id": "sensor_real_pos"
                }
            },
            {
                "name": "gear_velocity",
                "unit": "deg/s",
                "physical": false,
                "target": {
                    "kind": "sensor",
                    "id": "servo_vel"
                },
                "internal": true
            },
            {
                "name": "pot_reading",
                "physical": false,
                "target": {
                    "kind": "emulator"
                },
                "channel_type": "scalar",
                "dim": 1,
                "unit": "degrees",
                "internal": true
            },
            {
                "name": "drive",
                "physical": false,
                "target": {
                    "kind": "emulator"
                },
                "channel_type": "scalar",
                "dim": 1,
                "internal": true
            }
        ]
    },
    "emulator": {
        "type": "servo_emulator",
        "source": null,
        "parameters": {
            "pulse_min_us": 1000,
            "pulse_max_us": 2000,
            "travel_deg": 180,
            "frame_period_ms": 20,
            "deadband_us": 5,
            "proportional_band_deg": 4,
            "stall_torque_nm": 1.08,
            "no_load_speed_dps": 428,
            "rated_voltage": 6.0,
            "supply_voltage": 5.0,
            "pot_noise_deg": 0.3,
            "center_spread_us": 10,
            "gain_spread": 0.03
        },
        "parameter_sources": {
            "pulse_min_us": "estimate: 1–2 ms for ±90° (datasheets disagree; measure, plan task 37)",
            "pulse_max_us": "estimate: 1–2 ms for ±90° (datasheets disagree; measure, plan task 37)",
            "travel_deg": "estimate: 1–2 ms for ±90° (datasheets disagree; measure, plan task 37)",
            "frame_period_ms": "standard hobby servo signal: one pulse every 20 ms (50 Hz)",
            "deadband_us": "datasheet: TowerPro MG996R: dead band width 5 µs",
            "proportional_band_deg": "estimate: tuned so a 60° step matches the datasheet speed",
            "stall_torque_nm": "datasheet: TowerPro MG996R: 11 kgf·cm at 6 V",
            "no_load_speed_dps": "datasheet: TowerPro MG996R: 0.14 s/60° at 6 V",
            "rated_voltage": "datasheet: TowerPro MG996R: voltage of the torque and speed figures",
            "supply_voltage": "assumption: 5 V rail, until the power net exists (plan Phase 2)",
            "pot_noise_deg": "estimate, to be measured (plan task 37)",
            "center_spread_us": "estimate, to be measured (plan task 37)",
            "gain_spread": "estimate, to be measured (plan task 37)"
        }
    }
}

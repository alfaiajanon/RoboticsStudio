                ]
            }
        ],
        "joints": [
            {
                "id": "servo_joint",
                "body_a": "base",
                "body_b": "horn",
                "type": "hinge",
                "transform": {
                    "pos": [
                        0,
                        0,
                        0.021
                    ],
                    "quat": [
                        1,
                        0,
                        0,
                        0
                    ]
                },
                "range": [
                    -90,
                    90
                ],
                "damping": 0.14,
                "armature": 0.004,
                "frictionloss": 0.06,
                "collision": false
            },
            {
                "id": "backlash_joint",
                "body_a": "base",
                "body_b": "horn",
                "type": "hinge",
                "transform": {
                    "pos": [
                        0,
                        0,
                        0.0176
                    ],
                    "quat": [
                        1,
                        0,
                        0,
                        0
                    ]
                },
                "range": [
                    -1.5,
                    1.5
                ],
                "damping": 0,
                "armature": 0.0001,
                "frictionloss": 0.001,
                "collision": false
            }
        ],
        "tendons": [
            {
                "id": "output_tendon",
                "type": "fixed",
                "terms": [
                    {
                        "joint": "servo_joint",
                        "coef": 1
                    },
                    {
                        "joint": "backlash_joint",
                        "coef": 1
                    }
                ]
            }
        ]
    },
    "connectors": [
        {
            "id": "horn",

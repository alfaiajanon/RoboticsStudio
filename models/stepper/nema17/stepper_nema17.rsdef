{
    "schema": 3,
    "id": "stepper_nema17",
    "meta": {
        "hint_class": "actuator",
        "name": "NEMA 17 Stepper Motor",
        "version": "1.0.0",
        "author": "Anon",
        "icon_path": "nema17.png"
    },
    "resources": {
        "meshes": {
            "mesh_body": "meshes/stepper_nema17.obj"
        },
        "materials": {
            "mat_motor": "textures/tex_nema17.png"
        }
    },
    "specs": {
        "voltage_max": 24.0,
        "voltage_min": 9.0,
        "max_torque_nm": 0.45,
        "max_speed_rad": 20.0,
        "weight_kg": 0.28
    },
    "pins": [
        {
            "id": "vmot",
            "type": "power",
            "voltage_range": [
                9.0,
                24.0
            ],
            "description": "Motor power supply"
        },
        {
            "id": "step",
            "type": "digital",
            "description": "Pulse input for stepping"
        },
        {
            "id": "dir",
            "type": "digital",
            "description": "Direction control (HIGH/LOW)"
        },
        {
            "id": "gnd",
            "type": "ground",
            "description": "Common ground"
        }
    ],
    "kinematics": {
        "default_body": "base",
        "bodies": [
            {
                "id": "base",
                "overrideGeom": false,
                "transform": {
                    "pos": [
                        0,
                        0,
                        0
                    ],
                    "quat": [
                        1,
                        0,
                        0,
                        0
                    ]
                },
                "geoms": [
                    {
                        "id": "base_geom",
                        "type": "mesh",
                        "mesh": "mesh_body",
                        "material": "mat_motor",
                        "mass": 0.27
                    }
                ]
            },
            {
                "id": "shaft",
                "overrideGeom": false,
                "transform": {
                    "pos": [
                        0,
                        0,
                        0.036
                    ],
                    "quat": [
                        1,
                        0,
                        0,
                        0
                    ]
                },
                "geoms": [
                    {
                        "id": "shaft_geom",
                        "type": "cylinder",
                        "size": [
                            0.0025,
                            0.012
                        ],
                        "pos": [
                            0,
                            0,
                            0
                        ],
                        "mass": 0.01
                    }
                ]
            }
        ],
        "joints": [
            {
                "id": "stepper_joint",
                "body_a": "base",
                "body_b": "shaft",
                "type": "hinge",
                "transform": {
                    "pos": [
                        0,
                        0,
                        0.024
                    ],
                    "quat": [
                        1,
                        0,
                        0,
                        0
                    ]
                },
                "damping": 0.0001,
                "armature": 0.00036,
                "frictionloss": 0.01,
                "sources": {
                    "armature": "numerical: the minimum inertia that keeps the real torque-angle stiffness (holding x pi/2 / step = 20 N·m/rad) stable at the 2 ms physics step, Steps::StepperRotor::minInertia; the real rotor is ~5.4e-6 kg·m² (17HS4401: 54 g·cm²), so an almost unloaded motor accelerates slower than a real one",
                    "damping": "estimate: bearing loss only; the driver's damping is in the motor model",
                    "frictionloss": "estimate: stands in for the detent torque (~2.5 % of holding torque); to be measured (plan task 37)"
                }
            }
        ]
    },
    "connectors": [
        {
            "id": "shaft_tip",
            "body": "shaft",
            "description": "Flat tip of the 5mm shaft for pulleys or couplers",
            "mechanics": {
                "snap_angles": [
                    0,
                    90,
                    180,
                    270
                ]
            },
            "transform": {
                "pos": [
                    0,
                    0,
                    0.048
                ],
                "quat": [
                    1,
                    0,
                    0,
                    0
                ]
            }
        },
        {
            "id": "face_mount",
            "body": "base",
            "description": "Front face with M3 mounting holes",
            "mechanics": {
                "snap_angles": [
                    0,
                    90,
                    180,
                    270
                ]
            },
            "transform": {
                "pos": [
                    0,
                    0,
                    0.024
                ],
                "quat": [
                    1,
                    0,
                    0,
                    0
                ]
            }
        },
        {
            "id": "back_mount",
            "body": "base",
            "description": "Rear face of the motor",
            "mechanics": {
                "snap_angles": [
                    0,
                    90,
                    180,
                    270
                ]
            },
            "transform": {
                "pos": [
                    0,
                    0,
                    -0.024
                ],
                "quat": [
                    0,
                    1,
                    0,
                    0
                ]
            }
        }
    ],
    "devices": {
        "actuators": [
            {
                "id": "stepper_motor",
                "type": "motor",
                "target": {
                    "kind": "joint",
                    "id": "stepper_joint"
                },
                "ctrlrange": [
                    -0.6,
                    0.6
                ],
                "forcerange": [
                    -0.6,
                    0.6
                ]
            }
        ],
        "sensors": [
            {
                "id": "stepper_pos",
                "type": "jointpos",
                "target": {
                    "kind": "joint",
                    "id": "stepper_joint"
                }
            },
            {
                "id": "stepper_vel",
                "type": "jointvel",
                "target": {
                    "kind": "joint",
                    "id": "stepper_joint"
                }
            }
        ]
    },
    "interface": {
        "inputs": [
            {
                "name": "motor_torque",
                "unit": "N·m",
                "physical": false,
                "internal": true,
                "target": {
                    "kind": "actuator",
                    "id": "stepper_motor"
                }
            }
        ],
        "outputs": [
            {
                "name": "current_position",
                "unit": "radians",
                "physical": false,
                "target": {
                    "kind": "sensor",
                    "id": "stepper_pos"
                }
            },
            {
                "name": "current_velocity",
                "unit": "rad/s",
                "physical": false,
                "target": {
                    "kind": "sensor",
                    "id": "stepper_vel"
                }
            },
            {
                "name": "missed_steps",
                "physical": false,
                "internal": true,
                "target": {
                    "kind": "emulator"
                },
                "channel_type": "scalar",
                "dim": 1
            }
        ]
    },
    "emulator": {
        "type": "stepper_emulator",
        "source": null,
        "parameters": {
            "holding_torque_nm": 0.4,
            "step_angle_deg": 1.8,
            "microstepping": 1,
            "pullout_corner_rpm": 300
        },
        "parameter_sources": {
            "holding_torque_nm": "datasheet: 17HS4401 (typical NEMA17), holding torque 40 N·cm at rated current",
            "step_angle_deg": "datasheet: 17HS4401, 1.8° step angle (200 steps/rev)",
            "microstepping": "driver setting: A4988 with MS1-MS3 LOW = full steps; set 2/4/8/16 to match the driver's MS pins",
            "pullout_corner_rpm": "estimate: speed where the pull-out torque halves for a NEMA17 on an A4988 at 12 V (from typical torque-speed curves); to be measured (plan task 37)"
        }
    }
}

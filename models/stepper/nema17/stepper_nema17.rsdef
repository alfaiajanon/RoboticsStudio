{
    "schema": 2,
    "id": "stepper_nema17",
    "meta": {
        "name": "NEMA 17 Stepper Motor",
        "version": "1.0.0",
        "author": "Anon",
        "icon_path": "nema17.png"
    },
    "resources": {
        "meshes": {
            "mesh_body": "meshes/stepper_nema17.obj"
        },
        "materials": {
            "mat_motor": "textures/tex_nema17.png"
        }
    },
    "specs": {
        "voltage_max": 24.0,
        "voltage_min": 9.0,
        "max_torque_nm": 0.45,
        "max_speed_rad": 20.0,
        "weight_kg": 0.28
    },
    "pins": [
        {
            "id": "vmot",
            "voltage_range": [
                9.0,
                24.0
            ],
            "description": "Motor power supply"
        },
        {
            "id": "step",
            "description": "Pulse input for stepping"
        },
        {
            "id": "dir",
            "description": "Direction control (HIGH/LOW)"
        },
        {
            "id": "gnd",
            "description": "Common ground"
        }
    ],
    "kinematics": {
        "default_body": "base",
        "bodies": [
            {
                "id": "base",
                "overrideGeom": false,
                "transform": {
                    "pos": [
                        0,
                        0,
                        0
                    ],
                    "quat": [
                        1,
                        0,
                        0,
                        0
                    ]
                },
                "geoms": [
                    {
                        "id": "base_geom",
                        "type": "mesh",
                        "mesh": "mesh_body",
                        "material": "mat_motor",
                        "mass": 0.27
                    }
                ]
            },
            {
                "id": "shaft",
                "overrideGeom": false,
                "transform": {
                    "pos": [
                        0,
                        0,
                        0.036
                    ],
                    "quat": [
                        1,
                        0,
                        0,
                        0
                    ]
                },
                "geoms": [
                    {
                        "id": "shaft_geom",
                        "type": "cylinder",
                        "size": [
                            0.0025,
                            0.012
                        ],
                        "pos": [
                            0,
                            0,
                            0
                        ],
                        "mass": 0.01
                    }
                ]
            }
        ],
        "joints": [
            {
                "id": "stepper_joint",
                "body_a": "base",
                "body_b": "shaft",
                "type": "hinge",
                "transform": {
                    "pos": [
                        0,
                        0,
                        0.024
                    ],
                    "quat": [
                        1,
                        0,
                        0,
                        0
                    ]
                },
                "damping": 0.05,
                "armature": 0.01,
                "frictionloss": 0.02
            }
        ]
    },
    "connectors": [
        {
            "id": "shaft_tip",
            "body": "shaft",
            "description": "Flat tip of the 5mm shaft for pulleys or couplers",
            "mechanics": {
                "snap_angles": [
                    0,
                    90,
                    180,
                    270
                ]
            },
            "transform": {
                "pos": [
                    0,
                    0,
                    0.048
                ],
                "quat": [
                    1,
                    0,
                    0,
                    0
                ]
            }
        },
        {
            "id": "face_mount",
            "body": "base",
            "description": "Front face with M3 mounting holes",
            "mechanics": {
                "snap_angles": [
                    0,
                    90,
                    180,
                    270
                ]
            },
            "transform": {
                "pos": [
                    0,
                    0,
                    0.024
                ],
                "quat": [
                    1,
                    0,
                    0,
                    0
                ]
            }
        },
        {
            "id": "back_mount",
            "body": "base",
            "description": "Rear face of the motor",
            "mechanics": {
                "snap_angles": [
                    0,
                    90,
                    180,
                    270
                ]
            },
            "transform": {
                "pos": [
                    0,
                    0,
                    -0.024
                ],
                "quat": [
                    0,
                    1,
                    0,
                    0
                ]
            }
        }
    ],
    "devices": {
        "actuators": [
            {
                "id": "stepper_motor",
                "type": "velocity",
                "target": {
                    "kind": "joint",
                    "id": "stepper_joint"
                },
                "ctrlrange": [
                    -20.0,
                    20.0
                ],
                "forcerange": [
                    -0.45,
                    0.45
                ],
                "kv": 1.0
            }
        ],
        "sensors": [
            {
                "id": "stepper_pos",
                "type": "jointpos",
                "target": {
                    "kind": "joint",
                    "id": "stepper_joint"
                }
            },
            {
                "id": "stepper_vel",
                "type": "jointvel",
                "target": {
                    "kind": "joint",
                    "id": "stepper_joint"
                }
            }
        ]
    },
    "interface": {
        "inputs": [
            {
                "name": "target_velocity",
                "unit": "rad/s",
                "domain": {
                    "type": "ranged",
                    "parameters": {
                        "min": -20.0,
                        "max": 20.0
                    }
                },
                "physical": true,
                "target": {
                    "kind": "joint",
                    "id": "stepper_joint"
                }
            }
        ],
        "outputs": [
            {
                "name": "current_position",
                "unit": "radians",
                "physical": true,
                "target": {
                    "kind": "sensor",
                    "id": "stepper_pos"
                }
            },
            {
                "name": "current_velocity",
                "unit": "rad/s",
                "physical": true,
                "target": {
                    "kind": "sensor",
                    "id": "stepper_vel"
                }
            }
        ]
    },
    "emulator": {
        "type": "stepper_emulator",
        "source": null,
        "parameters": {
            "step_angle_deg": 1.8,
            "microstepping": 1,
            "holding_torque_factor": 1.0
        }
    }
}
